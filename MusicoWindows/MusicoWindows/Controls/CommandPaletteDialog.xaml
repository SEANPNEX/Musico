<UserControl x:Class="MusicoWindows.Controls.CommandPaletteDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid x:Name="BackdropGrid"
          Background="{DynamicResource DialogOverlayBrush}"
          MouseDown="Overlay_MouseDown">
        <Border x:Name="DialogCard"
                Width="600"
                MaxHeight="500"
                Margin="0,72,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{DynamicResource DialogSurfaceBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                MouseDown="Card_MouseDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search Input Row -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource Win10TextBoxStyle}"
                                 Height="38"
                                 Padding="34,6,12,6"
                                 FontSize="14"
                                 AutomationProperties.Name="{DynamicResource Str_CommandPalette_Title}"
                                 TextChanged="SearchBox_TextChanged"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown" />
                        <TextBlock Text="&#xE721;"
                                   FontFamily="{StaticResource Win10GlyphFont}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="11,0,0,0" />
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="{DynamicResource Str_CommandPalette_Placeholder}"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="36,0,12,0" />
                    </Grid>

                    <Button x:Name="CloseButton"
                            Grid.Column="1"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Width="36"
                            Height="38"
                            Margin="8,0,0,0"
                            Content="&#xE711;"
                            ToolTip="{DynamicResource Str_Common_Close}"
                            AutomationProperties.Name="{DynamicResource Str_Common_Close}"
                            Click="Close_Click" />
                </Grid>

                <!-- Results List -->
                <Grid Grid.Row="1" MaxHeight="360">
                    <ListBox x:Name="ResultsList"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch"
                             AutomationProperties.Name="{DynamicResource Str_CommandPalette_ResultsLabel}"
                             PreviewKeyDown="ResultsList_PreviewKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="10,8"
                                                    Cursor="Hand"
                                                    MouseLeftButtonUp="ResultItem_MouseLeftButtonUp">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Glyph}"
                                               FontFamily="{StaticResource Win10GlyphFont}"
                                               FontSize="15"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,10,0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontFamily="{StaticResource Win10Font}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontFamily="{StaticResource Win10Font}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding SubtitleVisibility}" />
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Background="{DynamicResource SubtleFillBrush}"
                                            BorderBrush="{DynamicResource ControlBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="7,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CategoryLabel}"
                                                   FontFamily="{StaticResource Win10Font}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock x:Name="EmptyResultsText"
                               Text="{DynamicResource Str_CommandPalette_NoResults}"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,28"
                               Visibility="Collapsed" />
                </Grid>

                <!-- Footer Hint -->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Margin="0,10,0,0"
                        Padding="2,8,2,0">
                    <TextBlock Text="{DynamicResource Str_CommandPalette_FooterHint}"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
