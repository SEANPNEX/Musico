<UserControl x:Class="MusicoWindows.Controls.TextInputDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <!-- Windows 10 ContentDialog backdrop -->
    <Grid x:Name="BackdropGrid"
          Background="{DynamicResource DialogOverlayBrush}"
          MouseDown="Overlay_MouseDown">
        <Border x:Name="DialogCard"
                Width="380"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource DialogSurfaceBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                MouseDown="Card_MouseDown">
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,8" />

                <TextBlock x:Name="MessageText"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14" />

                <TextBox x:Name="InputBox"
                         Style="{StaticResource Win10TextBoxStyle}"
                         Height="34"
                         KeyDown="InputBox_KeyDown"
                         TextChanged="InputBox_TextChanged" />

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ConfirmButton"
                            Grid.Column="0"
                            Style="{StaticResource Win10PrimaryButtonStyle}"
                            Content="{DynamicResource Str_Common_Save}"
                            Click="Confirm_Click" />
                    <Button Grid.Column="2"
                            Style="{StaticResource Win10ButtonStyle}"
                            Content="{DynamicResource Str_Common_Cancel}"
                            Click="Cancel_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
