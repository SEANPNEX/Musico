<UserControl x:Class="MusicoWindows.Controls.DownloadsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid x:Name="BackdropGrid"
          Background="{DynamicResource DialogOverlayBrush}"
          MouseDown="Overlay_MouseDown">
        <Border x:Name="DialogCard"
                Width="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource DialogSurfaceBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="0"
                Padding="24"
                MouseDown="Card_MouseDown">
            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE896;"
                                   FontFamily="{StaticResource Win10GlyphFont}"
                                   FontSize="18"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <TextBlock Text="{DynamicResource Str_Downloads_Title}"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="ClearFinishedButton"
                                Style="{StaticResource Win10ButtonStyle}"
                                Content="{DynamicResource Str_Downloads_ClearFinished}"
                                Margin="0,0,8,0"
                                Click="ClearFinished_Click" />
                        <Button Style="{StaticResource Win10IconButtonStyle}"
                                Content="&#xE711;"
                                ToolTip="{DynamicResource Str_Common_Close}"
                                AutomationProperties.Name="{DynamicResource Str_Common_Close}"
                                Click="Close_Click" />
                    </StackPanel>
                </Grid>

                <!-- Jobs List / Empty State -->
                <ScrollViewer MaxHeight="380"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="JobsStack" />
                </ScrollViewer>

                <TextBlock x:Name="EmptyStateText"
                           Text="{DynamicResource Str_Downloads_NoItems}"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,28,0,28"
                           Visibility="Collapsed" />

                <!-- Footer -->
                <Button Style="{StaticResource Win10PrimaryButtonStyle}"
                        Content="{DynamicResource Str_Common_Close}"
                        HorizontalAlignment="Right"
                        MinWidth="96"
                        Margin="0,14,0,0"
                        Click="Close_Click" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
