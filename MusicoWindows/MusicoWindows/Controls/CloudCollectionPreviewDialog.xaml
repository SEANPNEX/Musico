<UserControl x:Class="MusicoWindows.Controls.CloudCollectionPreviewDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MusicoWindows.Controls"
             Visibility="Collapsed">
    <Grid x:Name="BackdropGrid"
          Background="{DynamicResource DialogOverlayBrush}"
          MouseDown="Overlay_MouseDown">
        <Border x:Name="DialogCard"
                Width="760"
                Height="580"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource DialogSurfaceBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="0"
                Padding="24"
                MouseDown="Card_MouseDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:ArtworkImage x:Name="CoverArt"
                                           Grid.Column="0"
                                           Width="72"
                                           Height="72"
                                           GlyphSize="24"
                                           DecodeSize="160" />

                    <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                        <Border x:Name="KindBadge"
                                HorizontalAlignment="Left"
                                Padding="6,2"
                                Margin="0,0,0,4"
                                Background="{DynamicResource AccentSubtleBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1">
                            <TextBlock x:Name="KindBadgeText"
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                        <TextBlock x:Name="TitleText"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SubtitleText"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE711;"
                            VerticalAlignment="Top"
                            ToolTip="{DynamicResource Str_Common_Close}"
                            AutomationProperties.Name="{DynamicResource Str_Common_Close}"
                            Click="Close_Click" />
                </Grid>

                <!-- Action toolbar -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="PlayAllButton"
                            Style="{StaticResource Win10PrimaryButtonStyle}"
                            Margin="0,0,10,0"
                            IsEnabled="False"
                            Click="PlayAll_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Str_Preview_PlayAll}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AddFolderButton"
                            Style="{StaticResource Win10ButtonStyle}"
                            Click="AddFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F4;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="AddFolderButtonText" Text="{DynamicResource Str_Preview_AddAsCloudFolder}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Error Banner -->
                <Border x:Name="ErrorBanner"
                        Grid.Row="2"
                        Padding="12,10"
                        Margin="0,0,0,10"
                        Background="{DynamicResource DangerSubtleBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ErrorText"
                                   Grid.Column="0"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button x:Name="RetryButton"
                                Grid.Column="1"
                                Style="{StaticResource Win10ButtonStyle}"
                                Content="{DynamicResource Str_Songs_CloudRetry}"
                                Margin="12,0,0,0"
                                Click="Retry_Click" />
                    </Grid>
                </Border>

                <!-- Content area -->
                <Grid Grid.Row="3">
                    <ListBox x:Name="TracksList"
                             Background="Transparent"
                             BorderBrush="{DynamicResource DividerBrush}"
                             BorderThickness="1"
                             Padding="6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Standard"
                             HorizontalContentAlignment="Stretch"
                             SelectionChanged="TracksList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        Padding="10,7"
                                        Cursor="Hand"
                                        MouseEnter="TrackRow_MouseEnter"
                                        MouseLeave="TrackRow_MouseLeave"
                                        MouseLeftButtonUp="TrackRow_MouseLeftButtonUp"
                                        MouseRightButtonUp="TrackRow_MouseRightButtonUp">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding NumberText}"
                                                   FontFamily="{StaticResource Win10Font}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="6,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Track.Title}"
                                                       FontFamily="{StaticResource Win10Font}"
                                                       FontSize="13.5"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       FontFamily="{StaticResource Win10Font}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DurationText}"
                                                   FontFamily="{StaticResource Win10Font}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="LoadingPanel"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <ProgressBar IsIndeterminate="True" Width="180" Height="4" Margin="0,0,0,12" />
                        <TextBlock x:Name="LoadingText"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="EmptyText"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>

                <!-- Footer -->
                <Grid Grid.Row="4" Margin="0,14,0,0">
                    <TextBlock x:Name="AddStatusText"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="12"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left" />
                    <Button Style="{StaticResource Win10ButtonStyle}"
                            Content="{DynamicResource Str_Common_Close}"
                            HorizontalAlignment="Right"
                            Click="Close_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
