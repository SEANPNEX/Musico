<UserControl x:Class="MusicoWindows.Controls.CloudLyricsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid x:Name="BackdropGrid"
          Background="{DynamicResource DialogOverlayBrush}"
          MouseDown="Overlay_MouseDown">
        <Border x:Name="DialogCard"
                Width="820"
                Height="600"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource DialogSurfaceBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                MouseDown="Card_MouseDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE721;"
                                   FontFamily="{StaticResource Win10GlyphFont}"
                                   FontSize="18"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <TextBlock Text="{DynamicResource Str_CloudLyrics_Title}"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE711;"
                            HorizontalAlignment="Right"
                            ToolTip="{DynamicResource Str_Common_Close}"
                            AutomationProperties.Name="{DynamicResource Str_Common_Close}"
                            Click="Cancel_Click" />
                </Grid>

                <!-- Search fields -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Str_CloudLyrics_TitleField}"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="TitleBox"
                                 Style="{StaticResource Win10TextBoxStyle}"
                                 Height="32"
                                 KeyDown="InputBox_KeyDown" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Str_CloudLyrics_ArtistField}"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="ArtistBox"
                                 Style="{StaticResource Win10TextBoxStyle}"
                                 Height="32"
                                 KeyDown="InputBox_KeyDown" />
                    </StackPanel>
                    <Button x:Name="SearchButton"
                            Grid.Column="4"
                            Style="{StaticResource Win10PrimaryButtonStyle}"
                            Content="{DynamicResource Str_CloudLyrics_SearchBtn}"
                            VerticalAlignment="Bottom"
                            Height="32"
                            Padding="18,0"
                            Click="Search_Click" />
                </Grid>

                <!-- Source Switcher & Built-in Provider Note -->
                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SourceChipsPanel" Orientation="Horizontal" />
                    </ScrollViewer>
                    <TextBlock Text="{DynamicResource Str_CloudLyrics_ProviderNote}"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                </StackPanel>

                <!-- Main body: status or split candidate list + preview -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Candidates Column -->
                    <Border Grid.Column="0"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="PartialWarningText"
                                       Grid.Row="0"
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="10,6"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="CandidatesPanel" />
                            </ScrollViewer>
                            <StackPanel x:Name="StatusOverlayPanel"
                                        Grid.Row="1"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Margin="20"
                                        Visibility="Collapsed">
                                <ProgressBar x:Name="SearchProgress"
                                             Style="{StaticResource Win10ProgressBarStyle}"
                                             IsIndeterminate="True"
                                             Width="180"
                                             Margin="0,0,0,10"
                                             Visibility="Collapsed" />
                                <TextBlock x:Name="StatusTitleText"
                                           FontFamily="{StaticResource Win10Font}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6" />
                                <TextBlock x:Name="StatusDescText"
                                           FontFamily="{StaticResource Win10Font}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12" />
                                <Button x:Name="RetryButton"
                                        Style="{StaticResource Win10ButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Visibility="Collapsed"
                                        Click="Search_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Preview Column -->
                    <Border Grid.Column="2"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,8">
                                <Grid>
                                    <TextBlock x:Name="PreviewHeaderText"
                                               FontFamily="{StaticResource Win10Font}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <CheckBox x:Name="IncludeTranslationCheck"
                                              Style="{StaticResource Win10CheckBoxStyle}"
                                              Content="{DynamicResource Str_CloudLyrics_IncludeTranslation}"
                                              IsChecked="True"
                                              HorizontalAlignment="Right"
                                              Visibility="Collapsed"
                                              Checked="IncludeTranslation_Changed"
                                              Unchecked="IncludeTranslation_Changed" />
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12">
                                <TextBlock x:Name="PreviewBodyText"
                                           FontFamily="{StaticResource Win10Font}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Footer -->
                <Grid Grid.Row="4" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <CheckBox x:Name="ExportSidecarCheck"
                                  Style="{StaticResource Win10CheckBoxStyle}"
                                  Content="{DynamicResource Str_CloudLyrics_AlsoExportSidecar}"
                                  Visibility="Collapsed" />
                        <TextBlock x:Name="SaveErrorText"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="12"
                                   Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Win10ButtonStyle}"
                                Content="{DynamicResource Str_Common_Cancel}"
                                Margin="0,0,8,0"
                                Padding="18,6"
                                Click="Cancel_Click" />
                        <Button x:Name="UseLyricsButton"
                                Style="{StaticResource Win10PrimaryButtonStyle}"
                                Content="{DynamicResource Str_CloudLyrics_UseLyrics}"
                                IsEnabled="False"
                                Padding="18,6"
                                Click="Confirm_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
