<UserControl x:Class="MusicoWindows.Controls.SaveCloudFolderDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid x:Name="BackdropGrid"
          Background="{DynamicResource DialogOverlayBrush}"
          MouseDown="Overlay_MouseDown">
        <Border x:Name="DialogCard"
                Width="500"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource DialogSurfaceBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="0"
                Padding="24"
                MouseDown="Card_MouseDown">
            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE896;"
                                   FontFamily="{StaticResource Win10GlyphFont}"
                                   FontSize="18"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <TextBlock x:Name="TitleText"
                                   Text="{DynamicResource Str_SaveCloud_Title}"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="CloseIconButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE711;"
                            HorizontalAlignment="Right"
                            ToolTip="{DynamicResource Str_Common_Close}"
                            Click="CloseIcon_Click" />
                </Grid>

                <!-- Source Banner -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        Padding="12,10"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SourceSummaryText"
                                   Grid.Column="0"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Button x:Name="EditSourceUrlButton"
                                Grid.Column="1"
                                Style="{StaticResource Win10ButtonStyle}"
                                Content="{DynamicResource Str_SaveCloud_EditSource}"
                                Margin="10,0,0,0"
                                Padding="10,4"
                                MinHeight="26"
                                Visibility="Collapsed"
                                Click="EditSourceUrl_Click" />
                    </Grid>
                </Border>

                <!-- Inline Source URL Editor (for tracked folders) -->
                <Border x:Name="EditSourcePanel"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        Padding="12,10"
                        Margin="0,0,0,14"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_SaveCloud_EditSourceLabel}"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="EditSourceUrlBox"
                                 Style="{StaticResource Win10TextBoxStyle}"
                                 Height="32"
                                 KeyDown="EditSourceUrlBox_KeyDown" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,0,0">
                            <Button x:Name="SaveSourceUrlButton"
                                    Style="{StaticResource Win10PrimaryButtonStyle}"
                                    Content="{DynamicResource Str_Common_Save}"
                                    MinWidth="76"
                                    MinHeight="28"
                                    Padding="12,4"
                                    Margin="0,0,8,0"
                                    Click="SaveSourceUrl_Click" />
                            <Button x:Name="CancelEditSourceUrlButton"
                                    Style="{StaticResource Win10ButtonStyle}"
                                    Content="{DynamicResource Str_Common_Cancel}"
                                    MinWidth="76"
                                    MinHeight="28"
                                    Padding="12,4"
                                    Click="CancelEditSourceUrl_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Playlist / Single-Track Export Form -->
                <StackPanel x:Name="FormPanel">
                    <StackPanel x:Name="FolderNameSection">
                        <TextBlock Text="{DynamicResource Str_SaveCloud_FolderName}"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="FolderNameBox"
                                 Style="{StaticResource Win10TextBoxStyle}"
                                 Height="34"
                                 KeyDown="InputBox_KeyDown"
                                 TextChanged="FormInput_TextChanged" />
                    </StackPanel>

                    <StackPanel x:Name="SingleTrackQualitySection"
                                Visibility="Collapsed"
                                Margin="0">
                        <TextBlock Text="{DynamicResource Str_Quality_DownloadLabel}"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,6" />
                        <ComboBox x:Name="SingleTrackQualityCombo"
                                  Style="{StaticResource Win10ComboBoxStyle}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="QualityId" />
                    </StackPanel>

                    <TextBlock Text="{DynamicResource Str_SaveCloud_SaveLocation}"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,14,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LocationBox"
                                 Grid.Column="0"
                                 Style="{StaticResource Win10TextBoxStyle}"
                                 Height="34"
                                 KeyDown="InputBox_KeyDown"
                                 TextChanged="FormInput_TextChanged" />
                        <Button x:Name="BrowseButton"
                                Grid.Column="2"
                                Style="{StaticResource Win10ButtonStyle}"
                                Content="{DynamicResource Str_Common_Browse}"
                                Height="34"
                                Click="Browse_Click" />
                    </Grid>

                    <TextBlock x:Name="DestinationPreviewText"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,5,0,14" />

                    <CheckBox x:Name="AddToLibraryCheckBox"
                              Style="{StaticResource Win10CheckBoxStyle}"
                              Content="{DynamicResource Str_SaveCloud_AddToLibrary}"
                              IsChecked="True"
                              Margin="0,0,0,14" />
                </StackPanel>

                <!-- Live Progress Section -->
                <StackPanel x:Name="ProgressPanel"
                            Margin="0,0,0,14"
                            Visibility="Collapsed">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProgressStatusText"
                                   Grid.Column="0"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ProgressCountText"
                                   Grid.Column="1"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="12,0,0,0" />
                    </Grid>
                    <ProgressBar x:Name="ExportProgressBar"
                                 Style="{StaticResource Win10ProgressBarStyle}"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="0" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProgressBytesText"
                                   Grid.Column="0"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="ProgressSpeedText"
                                   Grid.Column="1"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="12,0,0,0" />
                    </Grid>
                </StackPanel>

                <!-- Completion Summary Section -->
                <StackPanel x:Name="SummaryPanel"
                            Margin="0,0,0,14"
                            Visibility="Collapsed">
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock x:Name="SummaryHeadlineText"
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="SummaryPathText"
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <TextBlock x:Name="LibraryStatusText"
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Margin="0,6,0,0"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="PartialErrorsBanner"
                            Background="{DynamicResource WarningBannerBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1"
                            Padding="10,8"
                            Margin="0,10,0,0"
                            Visibility="Collapsed">
                        <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="PartialErrorsText"
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="12"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- Error Banner -->
                <Border x:Name="ErrorBanner"
                        Background="{DynamicResource WarningBannerBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1"
                        Padding="10,8"
                        Margin="0,0,0,14"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="12"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Form / Busy Footer -->
                <Grid x:Name="ActiveActionsPanel" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SaveButton"
                            Grid.Column="0"
                            Style="{StaticResource Win10PrimaryButtonStyle}"
                            Content="{DynamicResource Str_SaveCloud_SaveFolder}"
                            Click="Save_Click" />
                    <Button x:Name="BackgroundButton"
                            Grid.Column="0"
                            Style="{StaticResource Win10ButtonStyle}"
                            Content="{DynamicResource Str_SaveCloud_RunInBackground}"
                            Visibility="Collapsed"
                            Click="Background_Click" />
                    <Button x:Name="CancelButton"
                            Grid.Column="2"
                            Style="{StaticResource Win10ButtonStyle}"
                            Content="{DynamicResource Str_Common_Cancel}"
                            Click="Cancel_Click" />
                </Grid>

                <!-- Completion Footer -->
                <Grid x:Name="DoneActionsPanel"
                      Margin="0,4,0,0"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="OpenFolderButton"
                            Grid.Column="0"
                            Style="{StaticResource Win10ButtonStyle}"
                            Content="{DynamicResource Str_SaveCloud_OpenFolder}"
                            Click="OpenFolder_Click" />
                    <Button x:Name="DoneButton"
                            Grid.Column="2"
                            Style="{StaticResource Win10PrimaryButtonStyle}"
                            Content="{DynamicResource Str_Common_Done}"
                            Click="Done_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
