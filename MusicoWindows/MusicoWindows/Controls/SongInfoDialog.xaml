<UserControl x:Class="MusicoWindows.Controls.SongInfoDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MusicoWindows.Controls"
             Visibility="Collapsed">
    <!-- Windows 10 ContentDialog backdrop -->
    <Grid x:Name="BackdropGrid"
          Background="{DynamicResource DialogOverlayBrush}"
          MouseDown="Overlay_MouseDown">
        <Border x:Name="DialogCard"
                Width="560"
                MaxHeight="680"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource DialogSurfaceBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="0"
                Padding="24"
                MouseDown="Card_MouseDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Dialog Header -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Song Info"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="SubtitleText"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <Button x:Name="CloseIconButton"
                            Grid.Column="1"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Width="30"
                            Height="30"
                            FontSize="11"
                            Content="&#xE8BB;"
                            ToolTip="Close"
                            Click="CloseIcon_Click" />
                </Grid>

                <!-- Scrollable Content -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="0,0,6,0">
                    <StackPanel>
                        <!-- Top Section: Editable Metadata -->
                        <TextBlock Text="METADATA"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,0,0,10" />

                        <!-- Cover Image Row -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="96" Height="96">
                                <controls:ArtworkImage x:Name="CoverArt"
                                                       Width="96"
                                                       Height="96"
                                                       DecodeSize="240"
                                                       GlyphSize="30" />
                                <Image x:Name="PreviewCoverImage"
                                       Width="96"
                                       Height="96"
                                       Stretch="UniformToFill"
                                       Visibility="Collapsed" />
                            </Grid>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="16,0,0,0">
                                <TextBlock Text="Cover Image"
                                           FontFamily="{StaticResource Win10Font}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="CoverStatusText"
                                           Text="Embedded or cached artwork"
                                           FontFamily="{StaticResource Win10Font}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,3,0,10" />
                                <Button x:Name="ChangeCoverButton"
                                        Style="{StaticResource Win10ButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Click="ChangeCover_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEB9F;"
                                                   FontFamily="{StaticResource Win10GlyphFont}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="Change Cover..." VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Title -->
                        <TextBlock Text="Title"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="TitleBox"
                                 Style="{StaticResource Win10TextBoxStyle}"
                                 Height="34"
                                 Margin="0,0,0,10" />

                        <!-- Artist + Quick-Search Link -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Artist"
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ArtistLinkButton"
                                    Grid.Column="1"
                                    Style="{StaticResource Win10FlatButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Padding="6,2"
                                    ToolTip="Search songs by this Artist"
                                    Click="ArtistLink_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;"
                                               FontFamily="{StaticResource Win10GlyphFont}"
                                               FontSize="11"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,5,0" />
                                    <TextBlock x:Name="ArtistLinkText"
                                               FontFamily="{StaticResource Win10Font}"
                                               FontSize="12"
                                               Foreground="{DynamicResource AccentBrush}"
                                               MaxWidth="260"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBox x:Name="ArtistBox"
                                 Style="{StaticResource Win10TextBoxStyle}"
                                 Height="34"
                                 Margin="0,0,0,10"
                                 TextChanged="MetadataInput_TextChanged" />

                        <!-- Album + Quick-Search Link -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Album"
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="AlbumLinkButton"
                                    Grid.Column="1"
                                    Style="{StaticResource Win10FlatButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Padding="6,2"
                                    ToolTip="Search songs in this Album"
                                    Click="AlbumLink_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;"
                                               FontFamily="{StaticResource Win10GlyphFont}"
                                               FontSize="11"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,5,0" />
                                    <TextBlock x:Name="AlbumLinkText"
                                               FontFamily="{StaticResource Win10Font}"
                                               FontSize="12"
                                               Foreground="{DynamicResource AccentBrush}"
                                               MaxWidth="260"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBox x:Name="AlbumBox"
                                 Style="{StaticResource Win10TextBoxStyle}"
                                 Height="34"
                                 Margin="0,0,0,10"
                                 TextChanged="MetadataInput_TextChanged" />

                        <!-- Genre + Quick-Search Link -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Genre"
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="GenreLinkButton"
                                    Grid.Column="1"
                                    Style="{StaticResource Win10FlatButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Padding="6,2"
                                    ToolTip="Search songs with this Genre"
                                    Click="GenreLink_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;"
                                               FontFamily="{StaticResource Win10GlyphFont}"
                                               FontSize="11"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,5,0" />
                                    <TextBlock x:Name="GenreLinkText"
                                               FontFamily="{StaticResource Win10Font}"
                                               FontSize="12"
                                               Foreground="{DynamicResource AccentBrush}"
                                               MaxWidth="260"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBox x:Name="GenreBox"
                                 Style="{StaticResource Win10TextBoxStyle}"
                                 Height="34"
                                 Margin="0,0,0,4"
                                 TextChanged="MetadataInput_TextChanged" />

                        <Border Height="1"
                                Background="{DynamicResource DividerBrush}"
                                Margin="0,14,0,14" />

                        <!-- Bottom Section: File & Playback Info -->
                        <TextBlock Text="FILE &amp; PLAYBACK INFO"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="0,0,0,10" />

                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                Padding="14,10">
                            <Grid x:Name="DetailsGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Precision" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3" />
                                <TextBlock x:Name="PrecisionValue" Grid.Row="0" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Frequency" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3" />
                                <TextBlock x:Name="FrequencyValue" Grid.Row="1" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Bit Rate" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3" />
                                <TextBlock x:Name="BitRateValue" Grid.Row="2" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="File Size" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3" />
                                <TextBlock x:Name="FileSizeValue" Grid.Row="3" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Length" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3" />
                                <TextBlock x:Name="LengthValue" Grid.Row="4" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Sound Tracks" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3" />
                                <TextBlock x:Name="ChannelsValue" Grid.Row="5" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Time Added" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3" />
                                <TextBlock x:Name="TimeAddedValue" Grid.Row="6" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Time Edited" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3" />
                                <TextBlock x:Name="TimeEditedValue" Grid.Row="7" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3" />

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Last Played" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3" />
                                <TextBlock x:Name="LastPlayedValue" Grid.Row="8" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3" />

                                <TextBlock Grid.Row="9" Grid.Column="0" Text="Played Times" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3" />
                                <TextBlock x:Name="PlayedTimesValue" Grid.Row="9" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3" />

                                <TextBlock Grid.Row="10" Grid.Column="0" Text="Source" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3" />
                                <TextBlock x:Name="LocationValue" Grid.Row="10" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SaveButton"
                            Grid.Column="0"
                            Style="{StaticResource Win10PrimaryButtonStyle}"
                            Content="Save"
                            Click="Save_Click" />
                    <Button x:Name="CancelButton"
                            Grid.Column="2"
                            Style="{StaticResource Win10ButtonStyle}"
                            Content="Cancel"
                            Click="Cancel_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
