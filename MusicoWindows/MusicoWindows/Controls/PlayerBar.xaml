<UserControl x:Class="MusicoWindows.Controls.PlayerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MusicoWindows.Controls"
             Height="84">
    <Border Background="{DynamicResource PlayerBarBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>

            <!-- Left: Artwork + Title + Artist (click opens FullPlayerView) -->
            <Button x:Name="NowPlayingButton"
                    Grid.Column="0"
                    Style="{StaticResource Win10FlatButtonStyle}"
                    Padding="4"
                    HorizontalContentAlignment="Left"
                    ToolTip="Open Now Playing"
                    Click="NowPlaying_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:ArtworkImage x:Name="CoverArt"
                                           Grid.Column="0"
                                           Width="52"
                                           Height="52"
                                           GlyphSize="18" />
                    <StackPanel Grid.Column="1"
                                Margin="12,0,6,0"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="TrackTitleText"
                                   Text="Not Playing"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TrackArtistText"
                                   Text="Pick a song from your library"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Center: Transport controls + Time scrubber -->
            <Grid Grid.Column="1"
                  MaxWidth="560"
                  Margin="20,0"
                  VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,2">
                    <Button x:Name="ShuffleButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE8B1;"
                            ToolTip="Shuffle"
                            Margin="0,0,10,0"
                            Click="Shuffle_Click" />
                    <Button x:Name="PrevButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE892;"
                            ToolTip="Previous (Ctrl+Left)"
                            Margin="0,0,8,0"
                            Click="Prev_Click" />
                    <Button x:Name="PlayPauseButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Width="38"
                            Height="38"
                            FontSize="17"
                            Content="&#xE768;"
                            ToolTip="Play / Pause (Space)"
                            Click="PlayPause_Click" />
                    <Button x:Name="NextButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE893;"
                            ToolTip="Next (Ctrl+Right)"
                            Margin="8,0,10,0"
                            Click="Next_Click" />
                    <Button x:Name="RepeatButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE8EE;"
                            ToolTip="Repeat"
                            Click="Repeat_Click" />
                </StackPanel>

                <Grid x:Name="ScrubberHost" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ElapsedText"
                               Grid.Column="0"
                               Text="0:00"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <Slider x:Name="ScrubberSlider"
                            Grid.Column="1"
                            Style="{StaticResource Win10SliderStyle}"
                            Minimum="0"
                            Maximum="1"
                            Value="0"
                            PreviewMouseLeftButtonDown="Scrubber_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="Scrubber_PreviewMouseLeftButtonUp"
                            LostMouseCapture="Scrubber_LostMouseCapture"
                            ValueChanged="Scrubber_ValueChanged" />
                    <TextBlock x:Name="RemainingText"
                               Grid.Column="2"
                               Text="-0:00"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </Grid>
            </Grid>

            <!-- Right: Volume, EQ, Sleep Timer, Lyrics & Queue toggles -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="MuteButton"
                        Style="{StaticResource Win10IconButtonStyle}"
                        Content="&#xE767;"
                        ToolTip="Mute"
                        Click="Mute_Click" />
                <Slider x:Name="VolumeSlider"
                        Style="{StaticResource Win10SliderStyle}"
                        Width="72"
                        Minimum="0"
                        Maximum="1"
                        Value="1"
                        Margin="2,0,8,0"
                        ToolTip="Volume"
                        ValueChanged="VolumeSlider_ValueChanged" />

                <Button x:Name="EqButton"
                        Style="{StaticResource Win10IconButtonStyle}"
                        Content="&#xE9E9;"
                        ToolTip="Equalizer"
                        Margin="0,0,2,0"
                        Click="Eq_Click" />
                <Button x:Name="SleepButton"
                        Style="{StaticResource Win10IconButtonStyle}"
                        Content="&#xE708;"
                        ToolTip="Sleep Timer"
                        Margin="0,0,2,0"
                        Click="Sleep_Click" />
                <Button x:Name="LyricsButton"
                        Style="{StaticResource Win10IconButtonStyle}"
                        Content="&#xE90A;"
                        ToolTip="Lyrics"
                        Margin="0,0,2,0"
                        Click="Lyrics_Click" />
                <Button x:Name="QueueButton"
                        Style="{StaticResource Win10IconButtonStyle}"
                        Content="&#xE90B;"
                        ToolTip="Queue"
                        Click="Queue_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
