<UserControl x:Class="MusicoWindows.Controls.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid x:Name="BackdropGrid"
          Background="{DynamicResource DialogOverlayBrush}"
          MouseDown="Overlay_MouseDown">
        <Border x:Name="DialogCard"
                Width="460"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource DialogSurfaceBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                MouseDown="Card_MouseDown">
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />

                <TextBlock x:Name="MessageText"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />

                <!-- Exact item & path details (used by delete choice prompt) -->
                <Border x:Name="DetailsPanel"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        Padding="12,10"
                        Margin="0,0,0,18"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ItemNameText"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ItemCountText"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,3,0,0"
                                   Visibility="Collapsed" />
                        <TextBlock x:Name="ItemPathText"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Standard 2-button footer -->
                <Grid x:Name="StandardButtonsGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ConfirmButton"
                            Grid.Column="0"
                            Style="{StaticResource Win10PrimaryButtonStyle}"
                            Content="{DynamicResource Str_Common_Confirm}"
                            Click="Confirm_Click" />
                    <Button x:Name="CancelButton"
                            Grid.Column="2"
                            Style="{StaticResource Win10ButtonStyle}"
                            Content="{DynamicResource Str_Common_Cancel}"
                            Click="Cancel_Click" />
                </Grid>

                <!-- 3-choice delete footer -->
                <StackPanel x:Name="DeleteChoiceButtonsPanel" Visibility="Collapsed">
                    <Button x:Name="RemoveFromLibraryButton"
                            Style="{StaticResource Win10ButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,8"
                            Click="RemoveFromLibrary_Click" />
                    <Button x:Name="MoveToRecycleBinButton"
                            Style="{StaticResource Win10PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,8"
                            Click="MoveToRecycleBin_Click" />
                    <Button x:Name="DeleteCancelButton"
                            Style="{StaticResource Win10ButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Content="{DynamicResource Str_Common_Cancel}"
                            Click="Cancel_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
