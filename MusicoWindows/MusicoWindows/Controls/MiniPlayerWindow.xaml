<Window x:Class="MusicoWindows.Controls.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MusicoWindows.Controls"
        Title="{DynamicResource Str_MiniPlayer_Title}"
        Width="340"
        Height="112"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        FontFamily="{StaticResource Win10Font}">
    <Border x:Name="RootCard"
            Background="{DynamicResource DialogSurfaceBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            MouseLeftButtonDown="RootCard_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="10,10,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <controls:ArtworkImage x:Name="CoverArt"
                                       Grid.Column="0"
                                       Width="56"
                                       Height="56"
                                       GlyphSize="20"
                                       DecodeSize="96"
                                       VerticalAlignment="Center" />

                <Grid Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="TrackTitleText"
                                   Text="{DynamicResource Str_PlayerBar_NotPlaying}"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TrackArtistText"
                                   Text="{DynamicResource Str_PlayerBar_PickSong}"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,4" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="-4,0,0,0">
                        <Button x:Name="PrevButton"
                                Style="{StaticResource Win10IconButtonStyle}"
                                Width="28"
                                Height="28"
                                FontSize="13"
                                Content="&#xE892;"
                                ToolTip="{DynamicResource Str_PlayerBar_PrevTooltip}"
                                AutomationProperties.Name="{DynamicResource Str_PlayerBar_PrevTooltip}"
                                Click="Prev_Click" />
                        <Button x:Name="PlayPauseButton"
                                Style="{StaticResource Win10IconButtonStyle}"
                                Width="30"
                                Height="28"
                                FontSize="15"
                                Margin="2,0"
                                Content="&#xE768;"
                                ToolTip="{DynamicResource Str_PlayerBar_PlayPauseTooltip}"
                                AutomationProperties.Name="{DynamicResource Str_PlayerBar_PlayPauseTooltip}"
                                Click="PlayPause_Click" />
                        <Button x:Name="NextButton"
                                Style="{StaticResource Win10IconButtonStyle}"
                                Width="28"
                                Height="28"
                                FontSize="13"
                                Content="&#xE893;"
                                ToolTip="{DynamicResource Str_PlayerBar_NextTooltip}"
                                AutomationProperties.Name="{DynamicResource Str_PlayerBar_NextTooltip}"
                                Click="Next_Click" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="PinButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Width="26"
                            Height="26"
                            FontSize="12"
                            Content="&#xE718;"
                            ToolTip="{DynamicResource Str_MiniPlayer_PinTooltip}"
                            AutomationProperties.Name="{DynamicResource Str_MiniPlayer_PinTooltip}"
                            Click="Pin_Click" />
                    <Button x:Name="RestoreButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Width="26"
                            Height="26"
                            FontSize="12"
                            Content="&#xE944;"
                            ToolTip="{DynamicResource Str_MiniPlayer_RestoreTooltip}"
                            AutomationProperties.Name="{DynamicResource Str_MiniPlayer_RestoreTooltip}"
                            Click="Restore_Click" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Width="26"
                            Height="26"
                            FontSize="11"
                            Content="&#xE8BB;"
                            ToolTip="{DynamicResource Str_Common_Close}"
                            AutomationProperties.Name="{DynamicResource Str_Common_Close}"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>

            <ProgressBar x:Name="ProgressTrack"
                         Grid.Row="1"
                         Style="{StaticResource Win10ProgressBarStyle}"
                         Height="3"
                         Minimum="0"
                         Maximum="1"
                         Value="0"
                         Margin="10,0,10,8" />
        </Grid>
    </Border>
</Window>
