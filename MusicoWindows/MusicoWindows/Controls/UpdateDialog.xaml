<UserControl x:Class="MusicoWindows.Controls.UpdateDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid x:Name="BackdropGrid"
          Background="{DynamicResource DialogOverlayBrush}"
          MouseDown="Overlay_MouseDown">
        <Border x:Name="DialogCard"
                Width="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource DialogSurfaceBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                MouseDown="Card_MouseDown">
            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE895;"
                                   FontFamily="{StaticResource Win10GlyphFont}"
                                   FontSize="18"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <TextBlock x:Name="TitleText"
                                   Text="{DynamicResource Str_Update_Title}"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="CloseIconButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE711;"
                            HorizontalAlignment="Right"
                            ToolTip="{DynamicResource Str_Common_Close}"
                            AutomationProperties.Name="{DynamicResource Str_Common_Close}"
                            Click="Close_Click" />
                </Grid>

                <!-- Version Summary Banner -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        Padding="14,12"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="VersionSummaryText"
                                       Text="Current version: 1.1.1"
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="ModeSubtitleText"
                                       Text="Checking GitHub Releases..."
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="AssetSizeText"
                                   Grid.Column="1"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <!-- Scrollable Release Notes -->
                <StackPanel x:Name="ReleaseNotesSection"
                            Margin="0,0,0,14"
                            Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Str_Update_ReleaseNotes}"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            Padding="12,10">
                        <ScrollViewer MaxHeight="200"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="ReleaseNotesText"
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="12"
                                       LineHeight="18"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- Progress Section (Checking / Downloading / Applying) -->
                <StackPanel x:Name="ProgressPanel"
                            Margin="0,0,0,14"
                            Visibility="Collapsed">
                    <Grid Margin="0,0,0,6">
                        <TextBlock x:Name="ProgressStatusText"
                                   Text="{DynamicResource Str_Update_Checking}"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="ProgressPercentText"
                                   HorizontalAlignment="Right"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                    <ProgressBar x:Name="DownloadProgressBar"
                                 Style="{StaticResource Win10ProgressBarStyle}"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0" />
                </StackPanel>

                <!-- Error Banner -->
                <Border x:Name="ErrorBanner"
                        Background="{DynamicResource WarningBannerBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1"
                        Padding="10,8"
                        Margin="0,0,0,14"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="12"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Action Buttons (Update Available) -->
                <Grid x:Name="UpdateActionsPanel"
                      Margin="0,4,0,0"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="UpdateNowButton"
                            Grid.Column="0"
                            Style="{StaticResource Win10PrimaryButtonStyle}"
                            Content="{DynamicResource Str_Update_UpdateNow}"
                            Click="UpdateNow_Click" />
                    <Button x:Name="SkipVersionButton"
                            Grid.Column="2"
                            Style="{StaticResource Win10ButtonStyle}"
                            Content="{DynamicResource Str_Update_SkipVersion}"
                            Click="SkipVersion_Click" />
                    <Button x:Name="OpenReleaseFromUpdateButton"
                            Grid.Column="4"
                            Style="{StaticResource Win10ButtonStyle}"
                            Content="{DynamicResource Str_Update_OpenReleasePage}"
                            Click="OpenReleasePage_Click" />
                </Grid>

                <!-- Action Buttons (Up To Date / Error / Checking) -->
                <Grid x:Name="SecondaryActionsPanel"
                      Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CheckAgainButton"
                            Grid.Column="0"
                            Style="{StaticResource Win10PrimaryButtonStyle}"
                            Content="{DynamicResource Str_Update_CheckAgain}"
                            Click="CheckAgain_Click" />
                    <Button x:Name="OpenReleasePageButton"
                            Grid.Column="2"
                            Style="{StaticResource Win10ButtonStyle}"
                            Content="{DynamicResource Str_Update_OpenReleasePage}"
                            Click="OpenReleasePage_Click" />
                    <Button x:Name="CloseButton"
                            Grid.Column="4"
                            Style="{StaticResource Win10ButtonStyle}"
                            Content="{DynamicResource Str_Common_Close}"
                            Click="Close_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
