<UserControl x:Class="MusicoWindows.Controls.LyricsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitleText"
                               Text="Lyrics"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SourceTagText"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0"
                               Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ImportButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE8E5;"
                            ToolTip="Import .lrc or .txt lyrics"
                            Click="Import_Click" />
                    <Button x:Name="RemoveButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE74D;"
                            ToolTip="Remove imported lyrics"
                            Visibility="Collapsed"
                            Click="Remove_Click" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE711;"
                            ToolTip="Close panel"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="LyricsScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,16">
                <StackPanel x:Name="LinesStack" Margin="0,0,0,120" />
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="28"
                        Visibility="Collapsed">
                <TextBlock Text="&#xE90A;"
                           FontFamily="{StaticResource Win10GlyphFont}"
                           FontSize="36"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />
                <TextBlock Text="No Lyrics"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <TextBlock Text="Import a .lrc or .txt file for this song, or place one with the same name next to it."
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,16" />
                <Button x:Name="EmptyImportButton"
                        Style="{StaticResource Win10PrimaryButtonStyle}"
                        Content="Import from File..."
                        HorizontalAlignment="Center"
                        Click="Import_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
