<UserControl x:Class="MusicoWindows.Controls.LyricsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitleText"
                               Text="{DynamicResource Str_Lyrics_Title}"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SourceTagText"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0"
                               Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SearchOnlineButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE721;"
                            ToolTip="{DynamicResource Str_Lyrics_SearchOnlineTooltip}"
                            AutomationProperties.Name="{DynamicResource Str_Lyrics_SearchOnlineTooltip}"
                            Click="SearchOnline_Click" />
                    <Button x:Name="ImportButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE8E5;"
                            ToolTip="{DynamicResource Str_Lyrics_ImportTooltip}"
                            AutomationProperties.Name="{DynamicResource Str_Lyrics_ImportTooltip}"
                            Click="Import_Click" />
                    <Button x:Name="ExportSidecarButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE74E;"
                            ToolTip="{DynamicResource Str_Lyrics_ExportSidecarTooltip}"
                            AutomationProperties.Name="{DynamicResource Str_Lyrics_ExportSidecarTooltip}"
                            Visibility="Collapsed"
                            Click="ExportSidecar_Click" />
                    <Button x:Name="RemoveButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE74D;"
                            ToolTip="{DynamicResource Str_Lyrics_RemoveTooltip}"
                            AutomationProperties.Name="{DynamicResource Str_Lyrics_RemoveTooltip}"
                            Visibility="Collapsed"
                            Click="Remove_Click" />
                    <Button x:Name="OptionsButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE712;"
                            ToolTip="{DynamicResource Str_Lyrics_OptionsTooltip}"
                            AutomationProperties.Name="{DynamicResource Str_Lyrics_OptionsTooltip}"
                            Click="Options_Click" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE711;"
                            ToolTip="{DynamicResource Str_Lyrics_ClosePanelTooltip}"
                            AutomationProperties.Name="{DynamicResource Str_Lyrics_ClosePanelTooltip}"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="LyricsScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,24"
                          PreviewMouseWheel="LyricsScroll_PreviewMouseWheel"
                          ScrollChanged="LyricsScroll_ScrollChanged">
                <ScrollViewer.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0.0" />
                        <GradientStop Color="#FFFFFFFF" Offset="0.08" />
                        <GradientStop Color="#FFFFFFFF" Offset="0.92" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </LinearGradientBrush>
                </ScrollViewer.OpacityMask>
                <StackPanel x:Name="LinesStack" Margin="0,8,0,120" />
            </ScrollViewer>

            <!-- Floating Sync to Current Line Pill -->
            <Button x:Name="SyncToCurrentButton"
                    Style="{StaticResource Win10PrimaryButtonStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,16"
                    Padding="14,6"
                    Visibility="Collapsed"
                    Click="SyncToCurrent_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;"
                               FontFamily="{StaticResource Win10GlyphFont}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <TextBlock Text="{DynamicResource Str_Lyrics_SyncToCurrent}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="28"
                        Visibility="Collapsed">
                <TextBlock Text="&#xE90A;"
                           FontFamily="{StaticResource Win10GlyphFont}"
                           FontSize="36"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />
                <TextBlock Text="{DynamicResource Str_Lyrics_EmptyTitle}"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <TextBlock Text="{DynamicResource Str_Lyrics_EmptyDesc}"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,16" />
                <Button x:Name="EmptySearchOnlineButton"
                        Style="{StaticResource Win10PrimaryButtonStyle}"
                        Content="{DynamicResource Str_Lyrics_SearchOnline}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,8"
                        Click="SearchOnline_Click" />
                <Button x:Name="EmptyImportButton"
                        Style="{StaticResource Win10ButtonStyle}"
                        Content="{DynamicResource Str_Lyrics_ImportFromFile}"
                        HorizontalAlignment="Center"
                        Click="Import_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
