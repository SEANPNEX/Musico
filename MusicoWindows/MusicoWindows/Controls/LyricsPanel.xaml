<UserControl x:Class="MusicoWindows.Controls.LyricsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Standalone Side-Panel Blurred Track-Artwork Ambient Backdrop -->
        <Grid x:Name="SideAmbientBackdropHost"
              Grid.RowSpan="2"
              Opacity="0.22"
              IsHitTestVisible="False"
              Visibility="Collapsed">
            <Image x:Name="SideAmbientBackdropImage"
                   Stretch="UniformToFill"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1.18" ScaleY="1.18" />
                </Image.RenderTransform>
                <Image.Effect>
                    <BlurEffect Radius="48" KernelType="Gaussian" />
                </Image.Effect>
            </Image>
        </Grid>
        <Border x:Name="SideAmbientScrim"
                Grid.RowSpan="2"
                Background="{DynamicResource SidePanelBrush}"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#CC000000" Offset="0.0" />
                    <GradientStop Color="#66000000" Offset="0.4" />
                    <GradientStop Color="#77000000" Offset="0.75" />
                    <GradientStop Color="#D8000000" Offset="1.0" />
                </LinearGradientBrush>
            </Border.OpacityMask>
        </Border>

        <!-- Header -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock x:Name="HeaderTitleText"
                               Text="{DynamicResource Str_Lyrics_Title}"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <Grid HorizontalAlignment="Left" Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HeaderArtistText"
                                   Grid.Column="0"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                        <Border x:Name="SourceTagBadge"
                                Grid.Column="1"
                                Background="{DynamicResource AccentSubtleBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="8,2"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <TextBlock x:Name="SourceTagText"
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SearchOnlineButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE721;"
                            ToolTip="{DynamicResource Str_Lyrics_SearchOnlineTooltip}"
                            AutomationProperties.Name="{DynamicResource Str_Lyrics_SearchOnlineTooltip}"
                            Click="SearchOnline_Click" />
                    <Button x:Name="ImportButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE8E5;"
                            ToolTip="{DynamicResource Str_Lyrics_ImportTooltip}"
                            AutomationProperties.Name="{DynamicResource Str_Lyrics_ImportTooltip}"
                            Click="Import_Click" />
                    <Button x:Name="ExportSidecarButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE74E;"
                            ToolTip="{DynamicResource Str_Lyrics_ExportSidecarTooltip}"
                            AutomationProperties.Name="{DynamicResource Str_Lyrics_ExportSidecarTooltip}"
                            Visibility="Collapsed"
                            Click="ExportSidecar_Click" />
                    <Button x:Name="RemoveButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE74D;"
                            ToolTip="{DynamicResource Str_Lyrics_RemoveTooltip}"
                            AutomationProperties.Name="{DynamicResource Str_Lyrics_RemoveTooltip}"
                            Visibility="Collapsed"
                            Click="Remove_Click" />
                    <Button x:Name="OptionsButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE712;"
                            ToolTip="{DynamicResource Str_Lyrics_OptionsTooltip}"
                            AutomationProperties.Name="{DynamicResource Str_Lyrics_OptionsTooltip}"
                            Click="Options_Click" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE711;"
                            ToolTip="{DynamicResource Str_Lyrics_ClosePanelTooltip}"
                            AutomationProperties.Name="{DynamicResource Str_Lyrics_ClosePanelTooltip}"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="LyricsScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,24"
                          PreviewMouseWheel="LyricsScroll_PreviewMouseWheel"
                          ScrollChanged="LyricsScroll_ScrollChanged">
                <ScrollViewer.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0.0" />
                        <GradientStop Color="#FFFFFFFF" Offset="0.08" />
                        <GradientStop Color="#FFFFFFFF" Offset="0.92" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </LinearGradientBrush>
                </ScrollViewer.OpacityMask>
                <StackPanel x:Name="LinesStack" Margin="0,8,0,120" />
            </ScrollViewer>

            <!-- Floating Sync to Current Line Pill -->
            <Button x:Name="SyncToCurrentButton"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,16"
                    Padding="14,7"
                    Cursor="Hand"
                    Foreground="{DynamicResource TextOnAccentBrush}"
                    Background="{DynamicResource AccentBrush}"
                    FontFamily="{StaticResource Win10Font}"
                    FontWeight="SemiBold"
                    Visibility="Collapsed"
                    Click="SyncToCurrent_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource RevealBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16" />
                            <Border x:Name="HoverLayer"
                                    Background="{DynamicResource AccentHoverBrush}"
                                    BorderBrush="{DynamicResource RevealBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                                <Setter TargetName="HoverLayer" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;"
                               FontFamily="{StaticResource Win10GlyphFont}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <TextBlock Text="{DynamicResource Str_Lyrics_SyncToCurrent}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="28"
                        Visibility="Collapsed">
                <TextBlock Text="&#xE90A;"
                           FontFamily="{StaticResource Win10GlyphFont}"
                           FontSize="36"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />
                <TextBlock Text="{DynamicResource Str_Lyrics_EmptyTitle}"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <TextBlock Text="{DynamicResource Str_Lyrics_EmptyDesc}"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,16" />
                <Button x:Name="EmptySearchOnlineButton"
                        Style="{StaticResource Win10PrimaryButtonStyle}"
                        Content="{DynamicResource Str_Lyrics_SearchOnline}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,8"
                        Click="SearchOnline_Click" />
                <Button x:Name="EmptyImportButton"
                        Style="{StaticResource Win10ButtonStyle}"
                        Content="{DynamicResource Str_Lyrics_ImportFromFile}"
                        HorizontalAlignment="Center"
                        Click="Import_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
