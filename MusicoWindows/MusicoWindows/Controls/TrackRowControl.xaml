<UserControl x:Class="MusicoWindows.Controls.TrackRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MusicoWindows.Controls">
    <Grid>
        <Border x:Name="RowBorder"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1"
                CornerRadius="0"
                Padding="10,7"
                Cursor="Hand"
                MouseEnter="Row_MouseEnter"
                MouseLeave="Row_MouseLeave"
                MouseLeftButtonUp="Row_MouseLeftButtonUp"
                DragOver="Row_DragOver"
                DragLeave="Row_DragLeave"
                Drop="Row_Drop">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Visible Drag Handle (enabled for Queue, Playlist, and Folder rows) -->
                <Border x:Name="DragHandle"
                        Grid.Column="0"
                        Width="24"
                        Height="32"
                        Margin="0,0,6,0"
                        Background="Transparent"
                        Cursor="SizeAll"
                        ToolTip="Drag to reorder"
                        Visibility="Collapsed"
                        PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="DragHandle_PreviewMouseMove">
                    <TextBlock Text="&#xE700;"
                               FontFamily="{StaticResource Win10GlyphFont}"
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <!-- Active playing indicator strip -->
                <Rectangle x:Name="ActiveBar"
                           Grid.Column="1"
                           Width="3"
                           Height="24"
                           Margin="0,0,8,0"
                           Fill="{DynamicResource AccentBrush}"
                           Visibility="Collapsed" />

                <!-- Cover artwork -->
                <controls:ArtworkImage x:Name="CoverArt"
                                       Grid.Column="2"
                                       Width="40"
                                       Height="40"
                                       GlyphSize="15" />

                <!-- Title & Subtitle -->
                <StackPanel Grid.Column="3"
                            Margin="12,0,12,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="14"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SubtitleText"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,1,0,0" />
                </StackPanel>

                <!-- Playing / Paused glyph -->
                <TextBlock x:Name="StateGlyph"
                           Grid.Column="4"
                           FontFamily="{StaticResource Win10GlyphFont}"
                           FontSize="13"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Visibility="Collapsed" />

                <!-- Duration -->
                <TextBlock x:Name="DurationText"
                           Grid.Column="5"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />

                <!-- Optional row action buttons (e.g. Move Up/Down/Remove in Playlist/Queue) -->
                <StackPanel x:Name="ActionHost"
                            Grid.Column="6"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- Drag-and-drop insertion indicators -->
        <Rectangle x:Name="DropTopIndicator"
                   Height="2"
                   VerticalAlignment="Top"
                   Fill="{DynamicResource AccentBrush}"
                   IsHitTestVisible="False"
                   Visibility="Collapsed" />
        <Rectangle x:Name="DropBottomIndicator"
                   Height="2"
                   VerticalAlignment="Bottom"
                   Fill="{DynamicResource AccentBrush}"
                   IsHitTestVisible="False"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
