<UserControl x:Class="MusicoWindows.Controls.AddCloudFolderDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid x:Name="BackdropGrid"
          Background="{DynamicResource DialogOverlayBrush}"
          MouseDown="Overlay_MouseDown">
        <Border x:Name="DialogCard"
                Width="470"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource DialogSurfaceBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="0"
                Padding="24"
                MouseDown="Card_MouseDown">
            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE753;"
                                   FontFamily="{StaticResource Win10GlyphFont}"
                                   FontSize="18"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <TextBlock Text="Add Cloud Folder"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="CloseIconButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE711;"
                            HorizontalAlignment="Right"
                            ToolTip="Close"
                            Click="Cancel_Click" />
                </Grid>

                <!-- URL Field -->
                <TextBlock Text="Playlist or Video URL"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="UrlBox"
                         Style="{StaticResource Win10TextBoxStyle}"
                         Height="34"
                         KeyDown="InputBox_KeyDown"
                         TextChanged="UrlBox_TextChanged" />
                <TextBlock Text="Supports YouTube / YouTube Music playlists &amp; videos (no login required), Bilibili favlists, collections, series, b23.tv &amp; BV links."
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,14" />

                <!-- Optional Cookie -->
                <TextBlock Text="Cookie (Optional)"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="CookieBox"
                         Style="{StaticResource Win10TextBoxStyle}"
                         Height="34"
                         KeyDown="InputBox_KeyDown" />
                <TextBlock Text="Only needed for private/authenticated playlists or higher Bilibili audio quality."
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,14" />

                <!-- Optional YouTube HTTP Proxy -->
                <TextBlock Text="HTTP Proxy (Optional — YouTube)"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="ProxyBox"
                         Style="{StaticResource Win10TextBoxStyle}"
                         Height="34"
                         KeyDown="InputBox_KeyDown" />
                <TextBlock Text="e.g. 7890, 127.0.0.1:7890, or http://127.0.0.1:7890"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,14" />

                <!-- Validation / Network Error Banner -->
                <Border x:Name="ErrorBanner"
                        Background="{DynamicResource WarningBannerBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1"
                        Padding="10,8"
                        Margin="0,0,0,14"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="12"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Busy Indicator -->
                <StackPanel x:Name="BusyPanel"
                            Margin="0,0,0,14"
                            Visibility="Collapsed">
                    <TextBlock Text="Fetching playlist tracks..."
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <ProgressBar Style="{StaticResource Win10ProgressBarStyle}"
                                 IsIndeterminate="True" />
                </StackPanel>

                <!-- Footer -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SubmitButton"
                            Grid.Column="0"
                            Style="{StaticResource Win10PrimaryButtonStyle}"
                            Content="Add Cloud Folder"
                            IsEnabled="False"
                            Click="Submit_Click" />
                    <Button x:Name="CancelButton"
                            Grid.Column="2"
                            Style="{StaticResource Win10ButtonStyle}"
                            Content="Cancel"
                            Click="Cancel_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
