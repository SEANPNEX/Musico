<UserControl x:Class="MusicoWindows.Controls.SleepTimerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid x:Name="BackdropGrid"
          Background="{DynamicResource DialogOverlayBrush}"
          MouseDown="Overlay_MouseDown">
        <Border x:Name="DialogCard"
                Width="460"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource DialogSurfaceBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                MouseDown="Card_MouseDown">
            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,16">
                    <TextBlock Text="{DynamicResource Str_SleepTimer_Title}"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE711;"
                            HorizontalAlignment="Right"
                            ToolTip="{DynamicResource Str_Common_Close}"
                            AutomationProperties.Name="{DynamicResource Str_Common_Close}"
                            Click="Done_Click" />
                </Grid>

                <!-- Active Timer Status Banner -->
                <Border x:Name="ActiveBanner"
                        Background="{DynamicResource AccentSubtleBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        Padding="12,10"
                        Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="&#xE708;"
                                       FontFamily="{StaticResource Win10GlyphFont}"
                                       FontSize="15"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBlock x:Name="ActiveStatusText"
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource Win10ButtonStyle}"
                                Content="{DynamicResource Str_SleepTimer_CancelTimer}"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Click="CancelTimer_Click" />
                    </Grid>
                </Border>

                <TextBlock Text="{DynamicResource Str_SleepTimer_StopPlayingAfter}"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,10" />

                <!-- Preset Grid -->
                <UniformGrid x:Name="PresetsGrid"
                             Columns="4"
                             Margin="0,0,0,14" />

                <!-- Custom Minutes Stepper -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        Padding="12,10"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CustomMinutesText"
                                   Grid.Column="0"
                                   Text="{DynamicResource Str_SleepTimer_DefaultMinutes}"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                            <Button Style="{StaticResource Win10ButtonStyle}"
                                    Content="-"
                                    Width="32"
                                    Padding="0"
                                    Margin="0,0,4,0"
                                    Click="DecreaseCustom_Click" />
                            <Button Style="{StaticResource Win10ButtonStyle}"
                                    Content="+"
                                    Width="32"
                                    Padding="0"
                                    Click="IncreaseCustom_Click" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Style="{StaticResource Win10PrimaryButtonStyle}"
                                Content="{DynamicResource Str_SleepTimer_Start}"
                                Padding="14,6"
                                Click="StartCustom_Click" />
                    </Grid>
                </Border>

                <!-- End of Current Song -->
                <Button Style="{StaticResource Win10ButtonStyle}"
                        HorizontalContentAlignment="Left"
                        Padding="12,10"
                        Margin="0,0,0,20"
                        Click="EndOfTrack_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE893;"
                                   FontFamily="{StaticResource Win10GlyphFont}"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <TextBlock Text="{DynamicResource Str_SleepTimer_EndOfCurrentSong}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Win10ButtonStyle}"
                        Content="{DynamicResource Str_Common_Done}"
                        MinWidth="100"
                        HorizontalAlignment="Right"
                        Click="Done_Click" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
