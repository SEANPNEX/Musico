<UserControl x:Class="MusicoWindows.Controls.EqualizerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid x:Name="BackdropGrid"
          Background="{DynamicResource DialogOverlayBrush}"
          MouseDown="Overlay_MouseDown">
        <Border x:Name="DialogCard"
                Width="540"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource DialogSurfaceBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="0"
                Padding="24"
                MouseDown="Card_MouseDown">
            <StackPanel>
                <!-- Header -->
                <Grid Margin="0,0,0,18">
                    <TextBlock Text="{DynamicResource Str_Equalizer_Title}"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE711;"
                            HorizontalAlignment="Right"
                            ToolTip="{DynamicResource Str_Common_Close}"
                            Click="Done_Click" />
                </Grid>

                <!-- Enable Toggle & Preset Selector -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="EnabledToggle"
                              Grid.Column="0"
                              Style="{StaticResource Win10ToggleSwitchStyle}"
                              VerticalAlignment="Center"
                              Checked="EnabledToggle_Changed"
                              Unchecked="EnabledToggle_Changed" />

                    <TextBlock Grid.Column="1"
                               Text="{DynamicResource Str_Equalizer_Preset}"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />

                    <ComboBox x:Name="PresetCombo"
                              Grid.Column="2"
                              Style="{StaticResource Win10ComboBoxStyle}"
                              SelectionChanged="PresetCombo_SelectionChanged" />
                </Grid>

                <!-- 10-Band Vertical Sliders -->
                <Border x:Name="BandsContainer"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        Padding="12,16"
                        Margin="0,0,0,18">
                    <Grid x:Name="BandsGrid" />
                </Border>

                <!-- Preamp Slider -->
                <StackPanel x:Name="PreampPanel" Margin="0,0,0,22">
                    <TextBlock x:Name="PreampLabel"
                               Text="{DynamicResource Str_Equalizer_PreampDefault}"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,6" />
                    <Slider x:Name="PreampSlider"
                            Style="{StaticResource Win10SliderStyle}"
                            Minimum="-12"
                            Maximum="12"
                            TickFrequency="0.5"
                            IsSnapToTickEnabled="True"
                            ValueChanged="PreampSlider_ValueChanged" />
                </StackPanel>

                <!-- Footer -->
                <Grid>
                    <Button Style="{StaticResource Win10ButtonStyle}"
                            Content="{DynamicResource Str_Equalizer_ResetToFlat}"
                            HorizontalAlignment="Left"
                            Click="Reset_Click" />
                    <Button Style="{StaticResource Win10PrimaryButtonStyle}"
                            Content="{DynamicResource Str_Common_Done}"
                            Width="100"
                            HorizontalAlignment="Right"
                            Click="Done_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
