<UserControl x:Class="MusicoWindows.Controls.FullPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MusicoWindows.Controls"
             xmlns:views="clr-namespace:MusicoWindows.Views"
             Visibility="Collapsed">
    <Grid x:Name="BackdropGrid" Background="{DynamicResource ContentBackgroundBrush}" ClipToBounds="True">
        <!-- Custom Global Background Layer -->
        <Image x:Name="CustomBackdropImage"
               Stretch="UniformToFill"
               IsHitTestVisible="False"
               Visibility="Collapsed" />
        <Border x:Name="CustomBackdropScrim"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

        <!-- Blurred Ambient Artwork Backdrop -->
        <Grid x:Name="AmbientBackdropHost"
              Opacity="0.28"
              IsHitTestVisible="False"
              Visibility="Collapsed">
            <Image x:Name="AmbientBackdropImage"
                   Stretch="UniformToFill"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1.14" ScaleY="1.14" />
                </Image.RenderTransform>
                <Image.Effect>
                    <BlurEffect Radius="64" KernelType="Gaussian" />
                </Image.Effect>
            </Image>
        </Grid>

        <!-- Soft Vertical Readability Gradient Scrim -->
        <Border x:Name="AmbientReadabilityScrim"
                Background="{DynamicResource ContentBackgroundBrush}"
                IsHitTestVisible="False">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#B8000000" Offset="0.0" />
                    <GradientStop Color="#38000000" Offset="0.34" />
                    <GradientStop Color="#44000000" Offset="0.72" />
                    <GradientStop Color="#CC000000" Offset="1.0" />
                </LinearGradientBrush>
            </Border.OpacityMask>
        </Border>

        <Grid x:Name="PlayerCard">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Button Style="{StaticResource Win10FlatButtonStyle}"
                        HorizontalAlignment="Left"
                        ToolTip="{DynamicResource Str_FullPlayer_CloseTooltip}"
                        Click="Close_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70D;"
                                   FontFamily="{StaticResource Win10GlyphFont}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Str_Common_Back}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <TextBlock Text="{DynamicResource Str_FullPlayer_NowPlaying}"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Two-column layout: Left = Artwork & Transport, Right = Win10 Pivot (Lyrics | Queue) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column -->
            <Grid Grid.Column="0" MaxWidth="520" Margin="32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Artwork (click switches right Pivot to Lyrics) -->
                <controls:ArtworkImage x:Name="CoverArt"
                                       Grid.Row="0"
                                       DecodeSize="600"
                                       GlyphSize="64"
                                       MaxWidth="360"
                                       MaxHeight="360"
                                       Margin="0,0,0,22"
                                       Cursor="Hand"
                                       ToolTip="{DynamicResource Str_FullPlayer_ShowLyricsTooltip}"
                                       MouseLeftButtonUp="Artwork_MouseLeftButtonUp" />

                <!-- Track Info + Song Info + Favourite Heart -->
                <Grid x:Name="TrackInfoBar"
                      Grid.Row="1"
                      Margin="0,0,0,16"
                      Background="Transparent"
                      MouseRightButtonUp="TrackInfo_MouseRightButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Text="{DynamicResource Str_FullPlayer_NothingPlaying}"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MetaText"
                                   Text="{DynamicResource Str_PlayerBar_PickSong}"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button x:Name="QualityButton"
                            Grid.Column="1"
                            Style="{StaticResource Win10ButtonStyle}"
                            Height="26"
                            MinHeight="26"
                            Padding="10,2"
                            FontSize="11"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            Margin="8,0,4,0"
                            Visibility="Collapsed"
                            ToolTip="{DynamicResource Str_FullPlayer_QualityTooltip}"
                            Click="Quality_Click" />
                    <Button x:Name="SongInfoButton"
                            Grid.Column="2"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Width="40"
                            Height="40"
                            FontSize="17"
                            Content="&#xE946;"
                            ToolTip="{DynamicResource Str_SongInfo_Title}"
                            AutomationProperties.Name="{DynamicResource Str_SongInfo_Title}"
                            Margin="4,0,2,0"
                            Click="SongInfo_Click" />
                    <Button x:Name="FavouriteButton"
                            Grid.Column="3"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Width="40"
                            Height="40"
                            FontSize="18"
                            Content="&#xEB51;"
                            ToolTip="{DynamicResource Str_FullPlayer_ToggleFavTooltip}"
                            AutomationProperties.Name="{DynamicResource Str_FullPlayer_ToggleFavTooltip}"
                            Click="Favourite_Click" />
                </Grid>

                <!-- Stacked Playback Scrubber -->
                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <Slider x:Name="ScrubberSlider"
                            Style="{StaticResource Win10SliderStyle}"
                            Minimum="0"
                            Maximum="1"
                            Value="0"
                            PreviewMouseLeftButtonDown="Scrubber_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="Scrubber_PreviewMouseLeftButtonUp"
                            LostMouseCapture="Scrubber_LostMouseCapture"
                            ValueChanged="Scrubber_ValueChanged" />
                    <Grid Margin="0,4,0,0">
                        <TextBlock x:Name="ElapsedText"
                                   Text="0:00"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Left" />
                        <TextBlock x:Name="RemainingText"
                                   Text="-0:00"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <!-- Large Transport Row -->
                <Grid Grid.Row="3" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ShuffleButton"
                            Grid.Column="0"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Width="44"
                            Height="44"
                            FontSize="17"
                            Content="&#xE8B1;"
                            ToolTip="{DynamicResource Str_Common_Shuffle}"
                            AutomationProperties.Name="{DynamicResource Str_Common_Shuffle}"
                            HorizontalAlignment="Center"
                            Click="Shuffle_Click" />
                    <Button x:Name="PrevButton"
                            Grid.Column="1"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Width="48"
                            Height="48"
                            FontSize="20"
                            Content="&#xE892;"
                            ToolTip="{DynamicResource Str_PlayerBar_PrevTooltip}"
                            AutomationProperties.Name="{DynamicResource Str_PlayerBar_PrevTooltip}"
                            HorizontalAlignment="Center"
                            Click="Prev_Click" />
                    <Button x:Name="PlayPauseButton"
                            Grid.Column="2"
                            Style="{StaticResource Win10PrimaryButtonStyle}"
                            Width="56"
                            Height="56"
                            Padding="0"
                            FontFamily="{StaticResource Win10GlyphFont}"
                            FontSize="22"
                            Content="&#xE768;"
                            ToolTip="{DynamicResource Str_PlayerBar_PlayPauseTooltip}"
                            AutomationProperties.Name="{DynamicResource Str_PlayerBar_PlayPauseTooltip}"
                            HorizontalAlignment="Center"
                            Click="PlayPause_Click" />
                    <Button x:Name="NextButton"
                            Grid.Column="3"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Width="48"
                            Height="48"
                            FontSize="20"
                            Content="&#xE893;"
                            ToolTip="{DynamicResource Str_PlayerBar_NextTooltip}"
                            AutomationProperties.Name="{DynamicResource Str_PlayerBar_NextTooltip}"
                            HorizontalAlignment="Center"
                            Click="Next_Click" />
                    <Button x:Name="RepeatButton"
                            Grid.Column="4"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Width="44"
                            Height="44"
                            FontSize="17"
                            Content="&#xE8EE;"
                            ToolTip="{DynamicResource Str_PlayerBar_RepeatTooltip}"
                            AutomationProperties.Name="{DynamicResource Str_PlayerBar_RepeatTooltip}"
                            HorizontalAlignment="Center"
                            Click="Repeat_Click" />
                </Grid>

                <!-- Queue & Track Position -->
                <TextBlock x:Name="QueuePositionText"
                           Grid.Row="4"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,14" />

                <!-- Bottom Utility Buttons (EQ, Sleep Timer) -->
                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="EqButton"
                            Style="{StaticResource Win10ButtonStyle}"
                            Margin="0,0,10,0"
                            Click="Eq_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9E9;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Str_Equalizer_Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SleepButton"
                            Style="{StaticResource Win10ButtonStyle}"
                            Click="Sleep_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE708;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Str_SleepTimer_Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Vertical Divider -->
            <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" />

            <!-- Right Column: Windows 10 Pivot (Lyrics | Queue) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="20,8,20,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LyricsPivotTab"
                                     Style="{StaticResource Win10PivotTabStyle}"
                                     Content="{DynamicResource Str_Lyrics_Title}"
                                     GroupName="FullPlayerPivot"
                                     IsChecked="True"
                                     Checked="PivotTab_Checked" />
                        <RadioButton x:Name="QueuePivotTab"
                                     Style="{StaticResource Win10PivotTabStyle}"
                                     Content="{DynamicResource Str_FullPlayer_QueueTab}"
                                     GroupName="FullPlayerPivot"
                                     Margin="16,0,0,0"
                                     Checked="PivotTab_Checked" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <controls:LyricsPanel x:Name="EmbeddedLyrics" Embedded="True" Background="Transparent" />
                    <views:QueuesView x:Name="EmbeddedQueues" Compact="True" Background="Transparent" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</UserControl>
