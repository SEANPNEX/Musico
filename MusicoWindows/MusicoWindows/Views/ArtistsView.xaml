<UserControl x:Class="MusicoWindows.Views.ArtistsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="24,20,24,14"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Artists" Style="{StaticResource Win10PageTitleStyle}" />
                <TextBlock x:Name="CountText"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ArtistsScroll" VerticalScrollBarVisibility="Auto" Padding="20,12">
                <StackPanel x:Name="ArtistsStack" Margin="0,0,0,28" />
            </ScrollViewer>

            <StackPanel x:Name="EmptyState"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="32"
                        Visibility="Collapsed">
                <TextBlock Text="&#xE720;"
                           FontFamily="{StaticResource Win10GlyphFont}"
                           FontSize="36"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />
                <TextBlock Text="No Artists Yet"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <TextBlock Text="Artists appear once your library has songs."
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
