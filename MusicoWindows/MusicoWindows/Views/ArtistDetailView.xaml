<UserControl x:Class="MusicoWindows.Views.ArtistDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MusicoWindows.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="20,12"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Button Style="{StaticResource Win10FlatButtonStyle}"
                    HorizontalAlignment="Left"
                    Click="Back_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{DynamicResource Str_Artists_Title}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel Margin="0,0,0,32">
                <!-- Artist Hero Header -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        ClipToBounds="True"
                        Margin="0,0,0,22">
                    <Grid>
                        <Image x:Name="HeroBackdropImage"
                               Stretch="UniformToFill"
                               Opacity="0.22"
                               IsHitTestVisible="False"
                               Visibility="Collapsed" />
                        <Border IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#14FFFFFF" Offset="0" />
                                    <GradientStop Color="#44000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid Margin="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <controls:ArtistAvatar x:Name="ArtistHeroAvatar"
                                                   Grid.Column="0"
                                                   Width="88"
                                                   Height="88"
                                                   Margin="0,0,20,0"
                                                   VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="ArtistNameText"
                                           Style="{StaticResource Win10PageTitleStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="ArtistMetaText"
                                           FontFamily="{StaticResource Win10Font}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Win10PrimaryButtonStyle}"
                                        Margin="0,0,8,0"
                                        Click="PlayAll_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{DynamicResource Str_Common_Play}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Win10ButtonStyle}"
                                        Margin="0,0,8,0"
                                        Click="ShuffleAll_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{DynamicResource Str_Common_Shuffle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MoreButton"
                                        Style="{StaticResource Win10IconButtonStyle}"
                                        Content="&#xE712;"
                                        ToolTip="{DynamicResource Str_Common_MoreOptions}"
                                        AutomationProperties.Name="{DynamicResource Str_Common_MoreOptions}"
                                        Click="More_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Albums Section -->
                <StackPanel x:Name="AlbumsSection" Margin="0,0,0,22">
                    <TextBlock Text="{DynamicResource Str_Albums_Title}"
                               Style="{StaticResource Win10SectionTitleStyle}"
                               Margin="0,0,0,12" />
                    <WrapPanel x:Name="AlbumsWrap" Orientation="Horizontal" />
                </StackPanel>

                <!-- Songs Section -->
                <TextBlock Text="{DynamicResource Str_Songs_Title}"
                           Style="{StaticResource Win10SectionTitleStyle}"
                           Margin="0,0,0,10" />
                <StackPanel x:Name="TracksStack" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
