<UserControl x:Class="MusicoWindows.Views.AlbumsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="24,20,24,14"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Str_Albums_Title}" Style="{StaticResource Win10PageTitleStyle}" />
                    <TextBlock x:Name="CountText"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>
                <Button x:Name="SelectAlbumsButton"
                        Style="{StaticResource Win10ButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Click="SelectAlbums_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE762;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Str_Select_Select}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Multi-Select Action Bar -->
        <Border x:Name="SelectionBar"
                Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,8"
                Visibility="Collapsed">
            <WrapPanel Orientation="Horizontal">
                <TextBlock x:Name="SelectionCountText"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <Button x:Name="SelectAllButton"
                        Style="{StaticResource Win10ButtonStyle}"
                        Margin="0,0,8,0"
                        Content="{DynamicResource Str_Select_SelectAll}"
                        Click="SelectAll_Click" />
                <Button x:Name="BatchEditTagsButton"
                        Style="{StaticResource Win10PrimaryButtonStyle}"
                        Margin="0,0,8,0"
                        Click="BatchEditTags_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Str_Select_EditTags}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelSelectionButton"
                        Style="{StaticResource Win10ButtonStyle}"
                        Content="{DynamicResource Str_Common_Cancel}"
                        Click="CancelSelection_Click" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <ScrollViewer x:Name="GridScroll" VerticalScrollBarVisibility="Auto" Padding="24,18">
                <ListBox x:Name="AlbumsList"
                         Style="{StaticResource Win10EmbeddedListBoxStyle}"
                         SelectionMode="Extended"
                         Margin="0,0,0,28"
                         SelectionChanged="AlbumsList_SelectionChanged"
                         PreviewKeyDown="AlbumsList_PreviewKeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="32"
                        Visibility="Collapsed">
                <TextBlock Text="&#xE93C;"
                           FontFamily="{StaticResource Win10GlyphFont}"
                           FontSize="36"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />
                <TextBlock Text="{DynamicResource Str_Albums_EmptyTitle}"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <TextBlock Text="{DynamicResource Str_Albums_EmptyDesc}"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
