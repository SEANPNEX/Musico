<UserControl x:Class="MusicoWindows.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header & Totals -->
        <Border Grid.Row="0"
                Padding="24,20,24,14"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{DynamicResource Str_Stats_Title}"
                           Style="{StaticResource Win10PageTitleStyle}"
                           VerticalAlignment="Center" />

                <!-- Totals Strip -->
                <Border Grid.Column="1"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        Padding="18,8">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel MinWidth="72" HorizontalAlignment="Center">
                            <TextBlock x:Name="TotalPlaysText"
                                       Text="0"
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="TotalPlaysLabel"
                                       Text="{DynamicResource Str_Stats_PlaysUnitPlural}"
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <Border Width="1" Background="{DynamicResource DividerBrush}" Margin="16,2" />

                        <StackPanel MinWidth="84" HorizontalAlignment="Center">
                            <TextBlock x:Name="TotalTimeText"
                                       Text="0 min"
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Str_Stats_ListenedLabel}"
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <Border Width="1" Background="{DynamicResource DividerBrush}" Margin="16,2" />

                        <StackPanel MinWidth="80" HorizontalAlignment="Center">
                            <TextBlock x:Name="NeverPlayedCountText"
                                       Text="0"
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Str_Stats_NeverPlayedLabel}"
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Win10 Pivot Underlined Section Tabs -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,4,24,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabRecent"
                                 Style="{StaticResource Win10PivotTabStyle}"
                                 Content="{DynamicResource Str_Stats_TabRecent}"
                                 GroupName="StatsPivot"
                                 IsChecked="True"
                                 Checked="Tab_Checked" />
                    <RadioButton x:Name="TabPlays"
                                 Style="{StaticResource Win10PivotTabStyle}"
                                 Content="{DynamicResource Str_Stats_TabPlays}"
                                 GroupName="StatsPivot"
                                 Margin="12,0,0,0"
                                 Checked="Tab_Checked" />
                    <RadioButton x:Name="TabStale"
                                 Style="{StaticResource Win10PivotTabStyle}"
                                 Content="{DynamicResource Str_Stats_TabNotLately}"
                                 GroupName="StatsPivot"
                                 Margin="12,0,0,0"
                                 Checked="Tab_Checked" />
                    <RadioButton x:Name="TabNever"
                                 Style="{StaticResource Win10PivotTabStyle}"
                                 Content="{DynamicResource Str_Stats_TabNever}"
                                 GroupName="StatsPivot"
                                 Margin="12,0,0,0"
                                 Checked="Tab_Checked" />
                </StackPanel>

                <ComboBox x:Name="PlaysOrderCombo"
                          Style="{StaticResource Win10ComboBoxStyle}"
                          Width="165"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,0,4"
                          Visibility="Collapsed"
                          SelectionChanged="PlaysOrderCombo_SelectionChanged" />
            </Grid>
        </Border>

        <!-- Play All / Shuffle -->
        <Border x:Name="ActionBar"
                Grid.Row="2"
                Padding="24,10"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Win10PrimaryButtonStyle}"
                        Margin="0,0,8,0"
                        Click="PlayAll_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Str_Common_PlayAll}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Win10ButtonStyle}"
                        Click="ShuffleAll_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Str_Common_Shuffle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Track List / Empty State -->
        <Grid Grid.Row="3">
            <ScrollViewer x:Name="TracksScroll" VerticalScrollBarVisibility="Auto" Padding="20,12">
                <StackPanel x:Name="TracksStack" Margin="0,0,0,28" />
            </ScrollViewer>

            <StackPanel x:Name="EmptyState"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="32"
                        Visibility="Collapsed">
                <TextBlock Text="&#xE9D9;"
                           FontFamily="{StaticResource Win10GlyphFont}"
                           FontSize="36"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />
                <TextBlock x:Name="EmptyTitleText"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <TextBlock x:Name="EmptyDescText"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
