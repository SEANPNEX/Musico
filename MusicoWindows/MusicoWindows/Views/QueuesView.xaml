<UserControl x:Class="MusicoWindows.Views.QueuesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                x:Name="HeaderBorder"
                Padding="24,20,24,14"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="Queues"
                               Style="{StaticResource Win10PageTitleStyle}" />
                    <TextBlock x:Name="SubtitleText"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Win10ButtonStyle}"
                            Margin="0,0,6,0"
                            ToolTip="New Queue"
                            Click="NewQueue_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="New Queue" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClearButton"
                            Style="{StaticResource Win10ButtonStyle}"
                            ToolTip="Clear Active Queue"
                            Click="ClearQueue_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Clear" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Queues Selector Strip / List -->
        <Border Grid.Row="1"
                x:Name="QueuesSelectorPanel"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="PLAY QUEUES"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="RenameButton"
                                Style="{StaticResource Win10FlatButtonStyle}"
                                Padding="8,4"
                                Margin="0,0,4,0"
                                Click="RenameQueue_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="Rename" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteButton"
                                Style="{StaticResource Win10FlatButtonStyle}"
                                Padding="8,4"
                                Click="DeleteQueue_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="Delete" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <WrapPanel x:Name="QueueCardsPanel" />
            </StackPanel>
        </Border>

        <!-- Active Queue Tracks -->
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="TracksScroll"
                          VerticalScrollBarVisibility="Auto"
                          Padding="20,12">
                <StackPanel x:Name="TracksStack" Margin="0,0,0,24" />
            </ScrollViewer>

            <StackPanel x:Name="EmptyState"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="32"
                        Visibility="Collapsed">
                <TextBlock Text="&#xE90B;"
                           FontFamily="{StaticResource Win10GlyphFont}"
                           FontSize="36"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />
                <TextBlock Text="Queue is Empty"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <TextBlock Text="Click any song in your library to start playing."
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
