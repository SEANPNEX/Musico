<UserControl x:Class="MusicoWindows.Views.SongsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MusicoWindows.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="24,20,24,14"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Str_Songs_Title}" Style="{StaticResource Win10PageTitleStyle}" />
                    <TextBlock x:Name="CountText"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <!-- Search & Source/Sort Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="SearchFieldChip"
                            Background="{DynamicResource AccentSubtleBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            Height="32"
                            Padding="8,0,4,0"
                            Margin="0,0,6,0"
                            Visibility="Collapsed"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="SearchFieldLabel"
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0" />
                            <Button Style="{StaticResource Win10IconButtonStyle}"
                                    Width="20"
                                    Height="20"
                                    FontSize="9"
                                    Content="&#xE711;"
                                    ToolTip="{DynamicResource Str_Songs_ClearFieldFilter}"
                                    AutomationProperties.Name="{DynamicResource Str_Songs_ClearFieldFilter}"
                                    Click="ClearSearchField_Click" />
                        </StackPanel>
                    </Border>

                    <ComboBox x:Name="SearchSourceCombo"
                              Style="{StaticResource Win10ComboBoxStyle}"
                              Width="136"
                              Margin="0,0,8,0"
                              DisplayMemberPath="Label"
                              SelectedValuePath="ExtensionId"
                              Visibility="Collapsed"
                              SelectionChanged="SearchSourceCombo_SelectionChanged" />

                    <Grid Width="240" Margin="0,0,10,0">
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource Win10TextBoxStyle}"
                                 Height="32"
                                 Padding="8,4,28,4"
                                 TextChanged="SearchBox_TextChanged"
                                 KeyDown="SearchBox_KeyDown" />
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="{DynamicResource Str_Songs_SearchPlaceholder}"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="10,0,28,0" />
                        <Button x:Name="ClearSearchButton"
                                Style="{StaticResource Win10IconButtonStyle}"
                                Width="28"
                                Height="28"
                                FontSize="11"
                                Content="&#xE711;"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,2,0"
                                ToolTip="{DynamicResource Str_Songs_ClearSearch}"
                                AutomationProperties.Name="{DynamicResource Str_Songs_ClearSearch}"
                                Visibility="Collapsed"
                                Click="ClearSearch_Click" />
                    </Grid>

                    <ComboBox x:Name="SortCombo"
                              Style="{StaticResource Win10ComboBoxStyle}"
                              Width="150"
                              SelectionChanged="SortCombo_SelectionChanged" />

                    <Button x:Name="CloudSearchButton"
                            Style="{StaticResource Win10PrimaryButtonStyle}"
                            Height="32"
                            MinWidth="88"
                            Visibility="Collapsed"
                            Content="{DynamicResource Str_Songs_SearchButton}"
                            Click="CloudSearch_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Action Bar: Local (Play All / Shuffle) OR Cloud Search (Kind Filter Pills + Status) -->
        <Border x:Name="ActionBar"
                Grid.Row="1"
                Padding="24,10"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel x:Name="LocalActionPanel" Orientation="Horizontal">
                    <Button x:Name="PlayAllButton"
                            Style="{StaticResource Win10PrimaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="PlayAll_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Str_Common_PlayAll}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ShuffleAllButton"
                            Style="{StaticResource Win10ButtonStyle}"
                            Click="ShuffleAll_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Str_Common_Shuffle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid x:Name="CloudActionBarGrid" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="KindFilterPanel"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="KindAllButton"
                                Style="{StaticResource Win10ButtonStyle}"
                                Padding="12,5"
                                Margin="0,0,6,0"
                                Tag=""
                                Content="{DynamicResource Str_Songs_KindAll}"
                                Click="KindFilter_Click" />
                        <Button x:Name="KindTracksButton"
                                Style="{StaticResource Win10ButtonStyle}"
                                Padding="12,5"
                                Margin="0,0,6,0"
                                Tag="track"
                                Content="{DynamicResource Str_Songs_KindTracks}"
                                Click="KindFilter_Click" />
                        <Button x:Name="KindAlbumsButton"
                                Style="{StaticResource Win10ButtonStyle}"
                                Padding="12,5"
                                Margin="0,0,6,0"
                                Tag="album"
                                Content="{DynamicResource Str_Songs_KindAlbums}"
                                Click="KindFilter_Click" />
                        <Button x:Name="KindPlaylistsButton"
                                Style="{StaticResource Win10ButtonStyle}"
                                Padding="12,5"
                                Margin="0,0,6,0"
                                Tag="playlist"
                                Content="{DynamicResource Str_Songs_KindPlaylists}"
                                Click="KindFilter_Click" />
                    </StackPanel>

                    <TextBlock x:Name="CloudStatusText"
                               Grid.Column="1"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cloud Loading / Structured Error Banners -->
            <StackPanel Grid.Row="0">
                <Border x:Name="CloudLoadingBanner"
                        Padding="24,10"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="140" Height="4" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{DynamicResource Str_Songs_CloudSearching}"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border x:Name="CloudErrorBanner"
                        Margin="24,12,24,4"
                        Padding="14,10"
                        Background="{DynamicResource DangerSubtleBrush}"
                        BorderBrush="{DynamicResource DangerBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="CloudErrorMessageText"
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="CloudErrorHintText"
                                       FontFamily="{StaticResource Win10Font}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0"
                                       Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CloudOpenExtensionsButton"
                                    Style="{StaticResource Win10ButtonStyle}"
                                    Margin="0,0,8,0"
                                    Visibility="Collapsed"
                                    Click="CloudOpenExtensions_Click" />
                            <Button x:Name="CloudRetryButton"
                                    Style="{StaticResource Win10ButtonStyle}"
                                    Content="{DynamicResource Str_Songs_CloudRetry}"
                                    Click="CloudRetry_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Virtualized Songs / Cloud Results List -->
            <Grid Grid.Row="1">
                <ListBox x:Name="SongsList"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="16,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Standard"
                         HorizontalContentAlignment="Stretch"
                         SelectionChanged="SongsList_SelectionChanged"
                         PreviewKeyDown="SongsList_PreviewKeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RowBorder"
                                    Background="{Binding RowBackground}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    Padding="10,7"
                                    Cursor="Hand"
                                    Opacity="{Binding RowOpacity}"
                                    MouseEnter="SongRow_MouseEnter"
                                    MouseLeave="SongRow_MouseLeave"
                                    MouseLeftButtonUp="SongRow_MouseLeftButtonUp"
                                    MouseRightButtonUp="SongRow_MouseRightButtonUp">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>

                                    <Rectangle Grid.Column="0"
                                               Width="3"
                                               Height="24"
                                               Margin="0,0,8,0"
                                               Fill="{DynamicResource AccentBrush}"
                                               Visibility="{Binding ActiveVisibility}" />

                                    <controls:ArtworkImage Grid.Column="1"
                                                           Width="40"
                                                           Height="40"
                                                           GlyphSize="{Binding PlaceholderGlyphSize}"
                                                           DecodeSize="96"
                                                           ArtworkCache="{Binding ArtworkCache}"
                                                           ArtworkKey="{Binding ArtworkKey}"
                                                           ThumbnailCache="{Binding ThumbnailCache}"
                                                           RemoteArtworkUrl="{Binding RemoteArtworkUrl}" />

                                    <StackPanel Grid.Column="2" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontFamily="{StaticResource Win10Font}"
                                                   FontSize="14"
                                                   FontWeight="{Binding TitleWeight}"
                                                   Foreground="{Binding TitleBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontFamily="{StaticResource Win10Font}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource SubtleFillBrush}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="1"
                                                Padding="6,2"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding KindBadgeVisibility}">
                                            <TextBlock Text="{Binding KindBadgeText}"
                                                       FontFamily="{StaticResource Win10Font}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding StateGlyph}"
                                                   FontFamily="{StaticResource Win10GlyphFont}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"
                                                   Visibility="{Binding ActiveVisibility}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="4"
                                               Text="{Binding TrailingText}"
                                               FontFamily="{StaticResource Win10Font}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State -->
                <StackPanel x:Name="EmptyState"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="32"
                            Visibility="Collapsed">
                    <TextBlock x:Name="EmptyGlyph"
                               Text="&#xE8D6;"
                               FontFamily="{StaticResource Win10GlyphFont}"
                               FontSize="36"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12" />
                    <TextBlock x:Name="EmptyTitleText"
                               Text="{DynamicResource Str_Songs_EmptyTitle}"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6" />
                    <TextBlock x:Name="EmptyDescText"
                               Text="{DynamicResource Str_Songs_EmptyDesc}"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Pagination Footer -->
            <Border x:Name="LoadMoreBar"
                    Grid.Row="2"
                    Padding="24,10,24,14"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                <Button x:Name="LoadMoreButton"
                        Style="{StaticResource Win10ButtonStyle}"
                        HorizontalAlignment="Center"
                        MinWidth="150"
                        Content="{DynamicResource Str_Songs_LoadMore}"
                        Click="LoadMore_Click" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
