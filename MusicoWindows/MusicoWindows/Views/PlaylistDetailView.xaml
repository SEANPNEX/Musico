<UserControl x:Class="MusicoWindows.Views.PlaylistDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MusicoWindows.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="BackBar"
                Grid.Row="0"
                Padding="20,12"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Button Style="{StaticResource Win10FlatButtonStyle}"
                    HorizontalAlignment="Left"
                    Click="Back_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{DynamicResource Str_Playlists_Title}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Border>

        <!-- Playlist Hero Header -->
        <Border Grid.Row="1"
                Margin="20,14,20,6"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                ClipToBounds="True">
            <Grid>
                <Image x:Name="HeroBackdropImage"
                       Stretch="UniformToFill"
                       Opacity="0.22"
                       IsHitTestVisible="False"
                       Visibility="Collapsed" />
                <Border IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#14FFFFFF" Offset="0" />
                            <GradientStop Color="#44000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Grid Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:ArtworkImage x:Name="PlaylistArt"
                                           Grid.Column="0"
                                           Width="76"
                                           Height="76"
                                           GlyphSize="26"
                                           DecodeSize="160"
                                           Margin="0,0,18,0"
                                           VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="TitleText"
                                   Style="{StaticResource Win10PageTitleStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="CountText"
                                   FontFamily="{StaticResource Win10Font}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="SortCombo"
                                  Style="{StaticResource Win10ComboBoxStyle}"
                                  Width="150"
                                  Margin="0,0,8,0"
                                  SelectionChanged="SortCombo_SelectionChanged" />
                        <Button x:Name="PlayAllButton"
                                Style="{StaticResource Win10PrimaryButtonStyle}"
                                Margin="0,0,8,0"
                                Click="PlayAll_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Str_Common_Play}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ShuffleAllButton"
                                Style="{StaticResource Win10ButtonStyle}"
                                Margin="0,0,8,0"
                                Click="ShuffleAll_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Str_Common_Shuffle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SelectTracksButton"
                                Style="{StaticResource Win10ButtonStyle}"
                                Margin="0,0,8,0"
                                Visibility="Collapsed"
                                Click="SelectTracks_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE762;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Str_Select_Select}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="MoreButton"
                                Style="{StaticResource Win10IconButtonStyle}"
                                Content="&#xE712;"
                                ToolTip="{DynamicResource Str_Common_MoreOptions}"
                                AutomationProperties.Name="{DynamicResource Str_Common_MoreOptions}"
                                Click="More_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Multi-Select Action Bar -->
        <Border x:Name="SelectionBar"
                Grid.Row="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,8"
                Visibility="Collapsed">
            <WrapPanel Orientation="Horizontal">
                <TextBlock x:Name="SelectionCountText"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <Button x:Name="SelectAllButton"
                        Style="{StaticResource Win10ButtonStyle}"
                        Margin="0,0,8,0"
                        Content="{DynamicResource Str_Select_SelectAll}"
                        Click="SelectAll_Click" />
                <Button x:Name="BatchEditTagsButton"
                        Style="{StaticResource Win10PrimaryButtonStyle}"
                        Margin="0,0,8,0"
                        Click="BatchEditTags_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Str_Select_EditTags}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelSelectionButton"
                        Style="{StaticResource Win10ButtonStyle}"
                        Content="{DynamicResource Str_Common_Cancel}"
                        Click="CancelSelection_Click" />
            </WrapPanel>
        </Border>

        <!-- Tracks -->
        <Grid Grid.Row="3">
            <ScrollViewer x:Name="TracksScroll" VerticalScrollBarVisibility="Auto" Padding="20,12">
                <ListBox x:Name="TracksList"
                         Style="{StaticResource Win10EmbeddedListBoxStyle}"
                         SelectionMode="Extended"
                         Margin="0,0,0,28"
                         SelectionChanged="TracksList_SelectionChanged"
                         PreviewKeyDown="TracksList_PreviewKeyDown" />
            </ScrollViewer>

            <StackPanel x:Name="EmptyState"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="32"
                        Visibility="Collapsed">
                <TextBlock Text="&#xE8D6;"
                           FontFamily="{StaticResource Win10GlyphFont}"
                           FontSize="36"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />
                <TextBlock Text="{DynamicResource Str_PlaylistDetail_EmptyTitle}"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <TextBlock Text="{DynamicResource Str_PlaylistDetail_EmptyDesc}"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
