<UserControl x:Class="MusicoWindows.Views.PlaylistDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="BackBar"
                Grid.Row="0"
                Padding="20,12"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Button Style="{StaticResource Win10FlatButtonStyle}"
                    HorizontalAlignment="Left"
                    Click="Back_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{DynamicResource Str_Playlists_Title}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Border>

        <!-- Playlist Header -->
        <Border Grid.Row="1"
                Padding="24,18,24,14"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{StaticResource Win10PageTitleStyle}" />
                    <TextBlock x:Name="CountText"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="SortCombo"
                              Style="{StaticResource Win10ComboBoxStyle}"
                              Width="150"
                              Margin="0,0,8,0"
                              SelectionChanged="SortCombo_SelectionChanged" />
                    <Button x:Name="PlayAllButton"
                            Style="{StaticResource Win10PrimaryButtonStyle}"
                            Margin="0,0,8,0"
                            Click="PlayAll_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Str_Common_Play}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ShuffleAllButton"
                            Style="{StaticResource Win10ButtonStyle}"
                            Margin="0,0,8,0"
                            Click="ShuffleAll_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Str_Common_Shuffle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MoreButton"
                            Style="{StaticResource Win10IconButtonStyle}"
                            Content="&#xE712;"
                            ToolTip="{DynamicResource Str_Common_MoreOptions}"
                            AutomationProperties.Name="{DynamicResource Str_Common_MoreOptions}"
                            Click="More_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tracks -->
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="TracksScroll" VerticalScrollBarVisibility="Auto" Padding="20,12">
                <StackPanel x:Name="TracksStack" Margin="0,0,0,28" />
            </ScrollViewer>

            <StackPanel x:Name="EmptyState"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="32"
                        Visibility="Collapsed">
                <TextBlock Text="&#xE8D6;"
                           FontFamily="{StaticResource Win10GlyphFont}"
                           FontSize="36"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />
                <TextBlock Text="{DynamicResource Str_PlaylistDetail_EmptyTitle}"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <TextBlock Text="{DynamicResource Str_PlaylistDetail_EmptyDesc}"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
