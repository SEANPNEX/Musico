<UserControl x:Class="MusicoWindows.Views.FoldersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="24,20,24,14"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="{DynamicResource Str_Folders_Title}"
                               Style="{StaticResource Win10PageTitleStyle}" />
                    <TextBlock x:Name="SubtitleText"
                               Text="{DynamicResource Str_Folders_Subtitle}"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RescanButton"
                            Style="{StaticResource Win10ButtonStyle}"
                            Margin="0,0,8,0"
                            Click="Rescan_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Str_Folders_Rescan}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AddCloudFolderButton"
                            Style="{StaticResource Win10ButtonStyle}"
                            Margin="0,0,8,0"
                            Click="AddCloudFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE753;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Str_Folders_AddCloudFolder}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AddFolderButton"
                            Style="{StaticResource Win10PrimaryButtonStyle}"
                            Click="AddFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F4;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Str_Folders_AddFolder}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scan Progress Banner -->
        <Border x:Name="ScanBanner"
                Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,10"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ScanStatusText"
                           Text="{DynamicResource Str_Folders_ScanningDefault}"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,6" />
                <ProgressBar x:Name="ScanProgressBar"
                             Style="{StaticResource Win10ProgressBarStyle}"
                             Minimum="0"
                             Maximum="1"
                             Value="0" />
            </StackPanel>
        </Border>

        <!-- Breadcrumb & Play/Shuffle Bar (visible when drilled into a folder) -->
        <Border x:Name="DrillBar"
                Grid.Row="2"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,10,24,4"
                Visibility="Collapsed">
            <StackPanel>
                <WrapPanel x:Name="BreadcrumbPanel"
                           Margin="0,0,0,8" />
                <WrapPanel Orientation="Horizontal">
                    <ComboBox x:Name="SortCombo"
                              Style="{StaticResource Win10ComboBoxStyle}"
                              Width="148"
                              Margin="0,0,8,6"
                              SelectionChanged="SortCombo_SelectionChanged" />
                    <Button x:Name="PlayFolderButton"
                            Style="{StaticResource Win10PrimaryButtonStyle}"
                            Margin="0,0,8,6"
                            Click="PlayFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Str_Common_PlayAll}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ShuffleFolderButton"
                            Style="{StaticResource Win10ButtonStyle}"
                            Margin="0,0,8,6"
                            Click="ShuffleFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Str_Common_Shuffle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SelectTracksButton"
                            Style="{StaticResource Win10ButtonStyle}"
                            Margin="0,0,8,6"
                            Visibility="Collapsed"
                            Click="SelectTracks_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE762;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Str_Select_Select}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NewFolderButton"
                            Style="{StaticResource Win10ButtonStyle}"
                            Margin="0,0,8,6"
                            Visibility="Collapsed"
                            Click="NewFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F4;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Str_Folders_NewFolder}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveCloudFolderButton"
                            Style="{StaticResource Win10ButtonStyle}"
                            Margin="0,0,8,6"
                            Visibility="Collapsed"
                            Click="SaveCloudFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Str_Folders_SaveToLocal}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="UpdateTrackedFolderButton"
                            Style="{StaticResource Win10ButtonStyle}"
                            Margin="0,0,8,6"
                            Visibility="Collapsed"
                            Click="UpdateTrackedFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Str_Folders_UpdateFromCloud}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="EditCloudSourceButton"
                            Style="{StaticResource Win10ButtonStyle}"
                            Margin="0,0,8,6"
                            Visibility="Collapsed"
                            Click="EditCloudSource_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Str_Folders_EditCloudSource}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RemoveRootButton"
                            Style="{StaticResource Win10ButtonStyle}"
                            Margin="0,0,8,6"
                            Visibility="Collapsed"
                            Click="RemoveRoot_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Str_Folders_RemoveFolder}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <WrapPanel x:Name="SelectionBar"
                           Orientation="Horizontal"
                           Margin="0,2,0,2"
                           Visibility="Collapsed">
                    <TextBlock x:Name="SelectionCountText"
                               FontFamily="{StaticResource Win10Font}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,6" />
                    <Button x:Name="SelectAllButton"
                            Style="{StaticResource Win10ButtonStyle}"
                            Margin="0,0,8,6"
                            Content="{DynamicResource Str_Select_SelectAll}"
                            Click="SelectAll_Click" />
                    <Button x:Name="BatchEditTagsButton"
                            Style="{StaticResource Win10PrimaryButtonStyle}"
                            Margin="0,0,8,6"
                            Click="BatchEditTags_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Str_Select_EditTags}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelSelectionButton"
                            Style="{StaticResource Win10ButtonStyle}"
                            Margin="0,0,0,6"
                            Content="{DynamicResource Str_Common_Cancel}"
                            Click="CancelSelection_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Scrollable Folder / Track List -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel Margin="0,0,0,32">
                <StackPanel x:Name="ContentStack" />
                <ListBox x:Name="TracksList"
                         Style="{StaticResource Win10EmbeddedListBoxStyle}"
                         SelectionMode="Extended"
                         Visibility="Collapsed"
                         SelectionChanged="TracksList_SelectionChanged"
                         PreviewKeyDown="TracksList_PreviewKeyDown" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
