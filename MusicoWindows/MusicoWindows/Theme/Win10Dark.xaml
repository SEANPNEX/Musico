<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows 10 Fluent Design Dark Palette (Groove Music Dark) + Musico Coral (#E85440) -->
    <Color x:Key="AccentColor">#E85440</Color>
    <Color x:Key="AccentHoverColor">#F06855</Color>
    <Color x:Key="AccentPressedColor">#CF422F</Color>
    <Color x:Key="AccentSubtleColor">#29E85440</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />

    <!-- Surfaces (Acrylic translucent NavPane + deep Groove Dark content surface) -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#CC141414" />
    <SolidColorBrush x:Key="NavPaneBrush" Color="#A8181818" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#00000000" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#F2171717" />
    <SolidColorBrush x:Key="PlayerBarBrush" Color="#EB1E1E1E" />
    <SolidColorBrush x:Key="SidePanelBrush" Color="#ED1B1B1B" />

    <!-- Cards & Lists -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF222222" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FF2C2C2C" />
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="ControlFillBrush" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FF363636" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#FF404040" />

    <!-- Reveal Highlight & Crisp 1px Borders -->
    <SolidColorBrush x:Key="RevealBorderBrush" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="DividerBrush" Color="#FF2A2A2A" />

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA6A6A6" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF737373" />
    <SolidColorBrush x:Key="SidebarTextPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SidebarTextSecondaryBrush" Color="#FFA6A6A6" />
    <SolidColorBrush x:Key="SidebarTextTertiaryBrush" Color="#FF737373" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFFFF" />

    <!-- Window Chrome Caption Buttons -->
    <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="#19FFFFFF" />
    <SolidColorBrush x:Key="CaptionButtonPressedBrush" Color="#29FFFFFF" />

    <!-- ContentDialog & Menus -->
    <SolidColorBrush x:Key="DialogOverlayBrush" Color="#99000000" />
    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#FF242424" />
    <SolidColorBrush x:Key="MenuSurfaceBrush" Color="#FF262626" />

    <!-- Status -->
    <SolidColorBrush x:Key="WarningBannerBrush" Color="#33FFB900" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FFFFB900" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#29FF6B6B" />

    <!-- Sliders -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#FFE85440" />
    <SolidColorBrush x:Key="SliderThumbFillBrush" Color="#FF1F1F1F" />
</ResourceDictionary>
