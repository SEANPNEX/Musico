<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows 10 Fluent Design Light Palette + Musico Coral (#E85440) -->
    <Color x:Key="AccentColor">#E85440</Color>
    <Color x:Key="AccentHoverColor">#D64835</Color>
    <Color x:Key="AccentPressedColor">#BD3A29</Color>
    <Color x:Key="AccentSubtleColor">#22E85440</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />

    <!-- Surfaces (Acrylic translucent NavPane + crisp Light content surface) -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#CCF2F2F2" />
    <SolidColorBrush x:Key="NavPaneBrush" Color="#B8EFEFEF" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="PlayerBarBrush" Color="#EBFAFAFA" />
    <SolidColorBrush x:Key="SidePanelBrush" Color="#F2F6F6F6" />

    <!-- Cards & Lists -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFF4F4F4" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FFE8E8E8" />
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#00000000" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#12000000" />
    <SolidColorBrush x:Key="SubtlePressedBrush" Color="#20000000" />
    <SolidColorBrush x:Key="ControlFillBrush" Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FFD8D8D8" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#FFC8C8C8" />

    <!-- Reveal Highlight & Crisp 1px Borders -->
    <SolidColorBrush x:Key="RevealBorderBrush" Color="#44000000" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="DividerBrush" Color="#FFE4E4E4" />

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF111111" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF5E5E5E" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="SidebarTextPrimaryBrush" Color="#FF111111" />
    <SolidColorBrush x:Key="SidebarTextSecondaryBrush" Color="#FF5E5E5E" />
    <SolidColorBrush x:Key="SidebarTextTertiaryBrush" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFFFF" />

    <!-- Window Chrome Caption Buttons -->
    <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="CaptionButtonPressedBrush" Color="#24000000" />

    <!-- ContentDialog & Menus -->
    <SolidColorBrush x:Key="DialogOverlayBrush" Color="#66000000" />
    <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="MenuSurfaceBrush" Color="#FFF7F7F7" />

    <!-- Status -->
    <SolidColorBrush x:Key="WarningBannerBrush" Color="#26FFB900" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FF9D5D00" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#20C42B1C" />

    <!-- Sliders -->
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#FFE85440" />
    <SolidColorBrush x:Key="SliderThumbFillBrush" Color="#FFFFFFFF" />
</ResourceDictionary>
