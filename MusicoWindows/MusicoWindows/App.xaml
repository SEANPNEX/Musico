<Application x:Class="MusicoWindows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MusicoWindows.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Win10Dark.xaml" />
                <ResourceDictionary Source="Theme/Win10Controls.xaml" />
                <ResourceDictionary Source="Localization/Strings.en.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:TimeFormatConverter x:Key="TimeFormatConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:GainTextConverter x:Key="GainTextConverter" />
            <conv:CountToSongsTextConverter x:Key="CountToSongsTextConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
