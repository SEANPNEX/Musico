<Window x:Class="MusicoWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MusicoWindows.Controls"
        xmlns:views="clr-namespace:MusicoWindows.Views"
        Title="Musico"
        Width="1180"
        Height="760"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource Win10Font}"
        Icon="pack://application:,,,/Assets/AppIcon.ico"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- Custom Windows 10 Title Bar -->
            <RowDefinition Height="32" />
            <!-- Main Application Shell -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="14,0,0,0">
                <TextBlock Text="&#xE8D6;"
                           FontFamily="{StaticResource Win10GlyphFont}"
                           FontSize="13"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBlock Text="Musico"
                           FontFamily="{StaticResource Win10Font}"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="MinimizeButton"
                        Style="{StaticResource Win10CaptionButtonStyle}"
                        Content="&#xE921;"
                        ToolTip="Minimize"
                        Click="Minimize_Click" />
                <Button x:Name="MaxRestoreButton"
                        Style="{StaticResource Win10CaptionButtonStyle}"
                        Content="&#xE922;"
                        ToolTip="Maximize"
                        Click="MaxRestore_Click" />
                <Button x:Name="CloseButton"
                        Style="{StaticResource Win10CloseButtonStyle}"
                        Content="&#xE8BB;"
                        ToolTip="Close"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>

        <!-- Shell Body + PlayerBar + Overlays -->
        <Grid Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="84" />
                </Grid.RowDefinitions>

                <!-- Split NavigationView + Content + Optional Side Panel -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="NavPaneColumn" Width="240" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="SidePanelColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Collapsible Acrylic NavigationView Pane -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource NavPaneBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Hamburger Toggle -->
                            <Button Grid.Row="0"
                                    Style="{StaticResource Win10FlatButtonStyle}"
                                    Height="40"
                                    HorizontalContentAlignment="Left"
                                    Padding="15,0"
                                    ToolTip="Toggle navigation pane"
                                    Click="Hamburger_Click">
                                <TextBlock Text="&#xE700;"
                                           FontFamily="{StaticResource Win10GlyphFont}"
                                           FontSize="15"
                                           VerticalAlignment="Center" />
                            </Button>

                            <!-- Scrollable Nav Items -->
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,4">
                                    <RadioButton x:Name="NavFolders"
                                                 Style="{StaticResource Win10NavItemStyle}"
                                                 GroupName="MainNav"
                                                 Tag="folders"
                                                 Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal" Margin="14,0">
                                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="15" Width="22" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LblFolders" Text="Folders" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                    <TextBlock x:Name="HdrLibrary"
                                               Text="LIBRARY"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="16,14,16,6" />

                                    <RadioButton x:Name="NavSongs"
                                                 Style="{StaticResource Win10NavItemStyle}"
                                                 GroupName="MainNav"
                                                 Tag="songs"
                                                 IsChecked="True"
                                                 Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal" Margin="14,0">
                                            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="15" Width="22" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LblSongs" Text="Songs" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="NavAlbums"
                                                 Style="{StaticResource Win10NavItemStyle}"
                                                 GroupName="MainNav"
                                                 Tag="albums"
                                                 Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal" Margin="14,0">
                                            <TextBlock Text="&#xE93C;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="15" Width="22" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LblAlbums" Text="Albums" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="NavArtists"
                                                 Style="{StaticResource Win10NavItemStyle}"
                                                 GroupName="MainNav"
                                                 Tag="artists"
                                                 Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal" Margin="14,0">
                                            <TextBlock Text="&#xE720;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="15" Width="22" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LblArtists" Text="Artists" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                    <TextBlock x:Name="HdrPlaylists"
                                               Text="PLAYLISTS"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="16,14,16,6" />

                                    <RadioButton x:Name="NavPlaylists"
                                                 Style="{StaticResource Win10NavItemStyle}"
                                                 GroupName="MainNav"
                                                 Tag="playlists"
                                                 Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal" Margin="14,0">
                                            <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="15" Width="22" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LblPlaylists" Text="All Playlists" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="NavFavourites"
                                                 Style="{StaticResource Win10NavItemStyle}"
                                                 GroupName="MainNav"
                                                 Tag="favourites"
                                                 Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal" Margin="14,0">
                                            <TextBlock Text="&#xEB51;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="15" Width="22" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LblFavourites" Text="Favourites" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                    <!-- Dynamic User Playlists -->
                                    <StackPanel x:Name="DynamicPlaylistsStack" />

                                    <Button x:Name="NewPlaylistNavButton"
                                            Style="{StaticResource Win10FlatButtonStyle}"
                                            Height="38"
                                            Padding="0"
                                            HorizontalContentAlignment="Left"
                                            ToolTip="New Playlist"
                                            Click="NewPlaylist_Click">
                                        <StackPanel Orientation="Horizontal" Margin="14,0">
                                            <TextBlock Text="&#xE710;"
                                                       FontFamily="{StaticResource Win10GlyphFont}"
                                                       FontSize="14"
                                                       Width="22"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock x:Name="LblNewPlaylist"
                                                       Text="New Playlist"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="12,10" />

                                    <RadioButton x:Name="NavQueues"
                                                 Style="{StaticResource Win10NavItemStyle}"
                                                 GroupName="MainNav"
                                                 Tag="queues"
                                                 Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal" Margin="14,0">
                                            <TextBlock Text="&#xE90B;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="15" Width="22" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LblQueues" Text="Queues" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="NavStats"
                                                 Style="{StaticResource Win10NavItemStyle}"
                                                 GroupName="MainNav"
                                                 Tag="stats"
                                                 Checked="NavItem_Checked">
                                        <StackPanel Orientation="Horizontal" Margin="14,0">
                                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Win10GlyphFont}" FontSize="15" Width="22" VerticalAlignment="Center" />
                                            <TextBlock x:Name="LblStats" Text="Stats" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Sidebar Footer: Theme Toggle & Rescan -->
                            <StackPanel Grid.Row="2"
                                        Margin="0,4,0,6">
                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,4" />
                                <Button x:Name="ThemeToggleButton"
                                        Style="{StaticResource Win10FlatButtonStyle}"
                                        Height="38"
                                        Padding="0"
                                        HorizontalContentAlignment="Left"
                                        ToolTip="Switch Light / Dark theme"
                                        Click="ToggleTheme_Click">
                                    <StackPanel Orientation="Horizontal" Margin="14,0">
                                        <TextBlock x:Name="ThemeGlyph"
                                                   Text="&#xE706;"
                                                   FontFamily="{StaticResource Win10GlyphFont}"
                                                   FontSize="15"
                                                   Width="22"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="LblTheme"
                                                   Text="Light Theme"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FooterRescanButton"
                                        Style="{StaticResource Win10FlatButtonStyle}"
                                        Height="38"
                                        Padding="0"
                                        HorizontalContentAlignment="Left"
                                        ToolTip="Rescan library folders"
                                        Click="RescanFooter_Click">
                                    <StackPanel Orientation="Horizontal" Margin="14,0">
                                        <TextBlock Text="&#xE72C;"
                                                   FontFamily="{StaticResource Win10GlyphFont}"
                                                   FontSize="15"
                                                   Width="22"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="LblRescan"
                                                   Text="Rescan Library"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CheckUpdatesButton"
                                        Style="{StaticResource Win10FlatButtonStyle}"
                                        Height="38"
                                        Padding="0"
                                        HorizontalContentAlignment="Left"
                                        ToolTip="Check for Updates"
                                        Click="CheckUpdatesFooter_Click">
                                    <StackPanel Orientation="Horizontal" Margin="14,0">
                                        <Grid Width="22" Height="22" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE895;"
                                                       FontFamily="{StaticResource Win10GlyphFont}"
                                                       FontSize="15"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Ellipse x:Name="UpdateBadgeDot"
                                                     Width="7"
                                                     Height="7"
                                                     Fill="{DynamicResource AccentBrush}"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Top"
                                                     Margin="0,1,0,0"
                                                     Visibility="Collapsed" />
                                        </Grid>
                                        <TextBlock x:Name="LblCheckUpdates"
                                                   Text="Check for Updates"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Active Content View -->
                    <Border Grid.Column="1" Background="{DynamicResource ContentBackgroundBrush}">
                        <ContentControl x:Name="ContentHost" />
                    </Border>

                    <!-- Optional Right Side Panel (340px Lyrics or Queue) -->
                    <Border x:Name="SidePanelBorder"
                            Grid.Column="2"
                            Background="{DynamicResource SidePanelBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1,0,0,0"
                            Visibility="Collapsed">
                        <Grid>
                            <controls:LyricsPanel x:Name="SideLyricsPanel" Visibility="Collapsed" />
                            <views:QueuesView x:Name="SideQueuesView" Compact="True" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Docked Bottom 84px PlayerBar -->
                <controls:PlayerBar x:Name="BottomPlayerBar" Grid.Row="1" />
            </Grid>

            <!-- Full-Window Now Playing Overlay -->
            <controls:FullPlayerView x:Name="FullPlayer" />

            <!-- Windows 10 ContentDialog Modal Overlays -->
            <controls:EqualizerDialog x:Name="EqDialog" />
            <controls:SleepTimerDialog x:Name="SleepDialog" />
            <controls:TextInputDialog x:Name="PromptDialog" />
            <controls:ConfirmDialog x:Name="ConfirmOverlay" />
            <controls:AddCloudFolderDialog x:Name="CloudDialog" />
            <controls:SaveCloudFolderDialog x:Name="SaveCloudDialog" />
            <controls:UpdateDialog x:Name="UpdateDialog" />
        </Grid>
    </Grid>
</Window>
